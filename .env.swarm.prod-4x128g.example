# Cloudreve Swarm 生产基线：
# - 1 个 manager + 3 个 worker
# - 每台 128GB 内存 / 64 线程
# - 目标：约 1000w 级元数据量，不把机器吃满，保留足够页缓存与突发余量
#
# 用法：
#   cp .env.swarm.prod-4x128g.example .env.swarm
#
# 推荐主机名：
# - cr-prod-mgr-1
# - cr-prod-wkr-1
# - cr-prod-wkr-2
# - cr-prod-wkr-3
#
# 推荐标签分布：
# - cr-prod-mgr-1：cloudreve.master, cloudreve.edge, cloudreve.registry, cloudreve.minio1, cloudreve.tika, cloudreve.kafka-ui
# - cr-prod-wkr-1：cloudreve.slave, cloudreve.edge, cloudreve.pg1, cloudreve.redis1, cloudreve.redis-sentinel, cloudreve.es1, cloudreve.kafka1, cloudreve.minio2
# - cr-prod-wkr-2：cloudreve.slave, cloudreve.pg2, cloudreve.redis2, cloudreve.redis-sentinel, cloudreve.es2, cloudreve.kafka2, cloudreve.minio3
# - cr-prod-wkr-3：cloudreve.slave, cloudreve.edge, cloudreve.pg3, cloudreve.redis3, cloudreve.redis-sentinel, cloudreve.es3, cloudreve.kafka3, cloudreve.minio4, cloudreve.tika

# 镜像版本
# - PostgreSQL Repmgr / Pgpool / Redis / MinIO 仍使用当前可用的 `bitnamilegacy/*` 固定 tag
# - `TIKA_IMAGE` 是自定义镜像，4 台机器上线前先 push 到固定 manager 上的私有仓库，再让其它节点远程拉取
# - 如果要提前把 PostgreSQL / Redis / MinIO 镜像预拉到各节点，先执行 `docker/swarm/prepare-bitnami-images.sh`
CLOUDREVE_IMAGE=cloudreve/cloudreve:4.15.0
CLOUDREVE_SLAVE_IMAGE=cloudreve/cloudreve:4.15.0
NGINX_IMAGE=nginx:1.27-alpine
PRIVATE_REGISTRY_STACK_NAME=cloudreve-registry
PRIVATE_REGISTRY_IMAGE=registry:2.8.3
PRIVATE_REGISTRY_SCHEME=http
PRIVATE_REGISTRY_ADDR=cr-prod-mgr-1:5000
PRIVATE_REGISTRY_REPLICAS=1
PRIVATE_REGISTRY_HTTP_PORT=5000
PRIVATE_REGISTRY_DELETE_ENABLED=true
PRIVATE_REGISTRY_DATA_MOUNT_TYPE=bind
PRIVATE_REGISTRY_DATA_MOUNT_SOURCE=/srv/cloudreve/registry
PRIVATE_REGISTRY_NODE_CONSTRAINT=node.labels.cloudreve.registry==true
PRIVATE_REGISTRY_CPU_RESERVATION=0.25
PRIVATE_REGISTRY_CPU_LIMIT=1.0
PRIVATE_REGISTRY_MEM_RESERVATION=256M
PRIVATE_REGISTRY_MEM_LIMIT=512M
PRIVATE_REGISTRY_IMAGE_KEYS=TIKA
TIKA_LOCAL_IMAGE=cloudreve/tika:3.2.3.0-full-unrar-charset
TIKA_REMOTE_IMAGE=${PRIVATE_REGISTRY_ADDR}/cloudreve/tika:3.2.3.0-full-unrar-charset
TIKA_IMAGE=${TIKA_REMOTE_IMAGE}
POSTGRESQL_REPMGR_IMAGE=bitnamilegacy/postgresql-repmgr:17.6.0-debian-12-r2
PGPOOL_IMAGE=bitnamilegacy/pgpool:4.6.3-debian-12-r0
REDIS_IMAGE=bitnamilegacy/redis:8.2.1-debian-12-r0
REDIS_SENTINEL_IMAGE=bitnamilegacy/redis-sentinel:8.2.1-debian-12-r0
REDIS_PROXY_IMAGE=haproxy:3.0-alpine
MINIO_IMAGE=bitnamilegacy/minio:2024.10.2-debian-12-r0
MINIO_PROXY_IMAGE=haproxy:3.0-alpine
ELASTICSEARCH_IMAGE=elasticsearch:8.12.2
ELASTICSEARCH_PROXY_IMAGE=haproxy:3.0-alpine
KAFKA_IMAGE=apache/kafka:4.2.0
KAFKA_PROXY_IMAGE=haproxy:3.0-alpine
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2

# 网络与集群模式
CLOUDREVE_BACKEND_SUBNET=10.20.0.0/24
SWARM_WITH_CLUSTER=yes
SWARM_ROLLING_ORDER=start-first

# 对象存储初始化
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
MINIO_DEFAULT_BUCKETS=cloudreve
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

CR_INIT_DEFAULT_STORAGE=s3
CR_INIT_S3_ENDPOINT=http://minio:9000
CR_INIT_S3_BUCKET=cloudreve
CR_INIT_S3_ACCESS_KEY=minio
CR_INIT_S3_SECRET_KEY=replace-with-strong-minio-password
CR_INIT_S3_REGION=us-east-1
CR_INIT_S3_FORCE_PATH_STYLE=true
CR_INIT_S3_RELAY=true
CR_INIT_S3_INTERNAL_PROXY=true
CR_INIT_S3_IS_PRIVATE=true
CR_INIT_S3_CHUNK_SIZE=26214400

# Kafka 全局配置默认保守关闭。
# 如果你明确要让 Cloudreve 直接使用栈内 Kafka，再改成 true。
CLOUDREVE_GLOBAL_KAFKA_ENABLED=false
CLOUDREVE_GLOBAL_KAFKA_BROKERS=kafka:9092
CLOUDREVE_GLOBAL_KAFKA_VERSION=3.7.0
CLOUDREVE_GLOBAL_KAFKA_CLIENT_ID=cloudreve
CLOUDREVE_GLOBAL_KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# 入口与主从
CLOUDREVE_SITE_URL=https://cloudreve.example.com
CLOUDREVE_SESSION_SECRET=replace-with-at-least-64-random-chars

CLOUDREVE_MASTER_RUNTIME_MOUNT_TYPE=bind
CLOUDREVE_MASTER_RUNTIME_MOUNT_SOURCE=/srv/cloudreve/runtime/master
CLOUDREVE_MASTER_NODE_CONSTRAINT=node.labels.cloudreve.master==true
CLOUDREVE_MASTER_REPLICAS=1
CLOUDREVE_MASTER_CPU_RESERVATION=2.0
CLOUDREVE_MASTER_CPU_LIMIT=4.0
CLOUDREVE_MASTER_MEM_RESERVATION=4G
CLOUDREVE_MASTER_MEM_LIMIT=8G

CLOUDREVE_MASTER_HTTP_PORT=80
CLOUDREVE_MASTER_PROXY_REPLICAS=2
CLOUDREVE_MASTER_PROXY_CPU_RESERVATION=0.5
CLOUDREVE_MASTER_PROXY_CPU_LIMIT=1.0
CLOUDREVE_MASTER_PROXY_MEM_RESERVATION=512M
CLOUDREVE_MASTER_PROXY_MEM_LIMIT=1G
CLOUDREVE_MASTER_PROXY_NODE_CONSTRAINT=node.labels.cloudreve.edge==true

CLOUDREVE_SLAVE_SECRET=replace-with-cloudreve-admin-generated-slave-key-after-first-boot-0000
CLOUDREVE_SLAVE_RUNTIME_MOUNT_TYPE=bind
CLOUDREVE_SLAVE_RUNTIME_MOUNT_SOURCE=/srv/cloudreve/runtime/slave
CLOUDREVE_SLAVE_NODE_CONSTRAINT=node.labels.cloudreve.slave==true
CLOUDREVE_SLAVE_REPLICAS=2
CLOUDREVE_SLAVE_CPU_RESERVATION=2.0
CLOUDREVE_SLAVE_CPU_LIMIT=4.0
CLOUDREVE_SLAVE_MEM_RESERVATION=4G
CLOUDREVE_SLAVE_MEM_LIMIT=8G

CLOUDREVE_SLAVE_HTTP_PORT=5213
CLOUDREVE_SLAVE_PROXY_REPLICAS=2
CLOUDREVE_SLAVE_PROXY_CPU_RESERVATION=0.5
CLOUDREVE_SLAVE_PROXY_CPU_LIMIT=1.0
CLOUDREVE_SLAVE_PROXY_MEM_RESERVATION=512M
CLOUDREVE_SLAVE_PROXY_MEM_LIMIT=1G
CLOUDREVE_SLAVE_PROXY_NODE_CONSTRAINT=node.labels.cloudreve.edge==true

# PostgreSQL
POSTGRESQL_USERNAME=cloudreve
POSTGRESQL_DATABASE=cloudreve
POSTGRESQL_PASSWORD=replace-with-strong-app-password
POSTGRESQL_POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRESQL_NUM_SYNCHRONOUS_REPLICAS=1
REPMGR_PASSWORD=replace-with-strong-repmgr-password
PGPOOL_REPLICAS=2
PGPOOL_ADMIN_USERNAME=admin
PGPOOL_ADMIN_PASSWORD=replace-with-strong-pgpool-admin-password
PGPOOL_PUBLIC_PORT=15432

POSTGRESQL_CPU_RESERVATION=4.0
POSTGRESQL_CPU_LIMIT=8.0
POSTGRESQL_MEM_RESERVATION=12G
POSTGRESQL_MEM_LIMIT=20G
PGPOOL_CPU_RESERVATION=1.0
PGPOOL_CPU_LIMIT=2.0
PGPOOL_MEM_RESERVATION=1G
PGPOOL_MEM_LIMIT=2G
PGPOOL_NODE_CONSTRAINT=node.labels.cloudreve.edge==true

PG_1_DATA_MOUNT_TYPE=bind
PG_1_DATA_MOUNT_SOURCE=/srv/cloudreve/postgresql/1
PG_2_DATA_MOUNT_TYPE=bind
PG_2_DATA_MOUNT_SOURCE=/srv/cloudreve/postgresql/2
PG_3_DATA_MOUNT_TYPE=bind
PG_3_DATA_MOUNT_SOURCE=/srv/cloudreve/postgresql/3

# Redis
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_AOF_ENABLED=yes
REDIS_MASTER_HOST=redis-1
REDIS_MASTER_PORT_NUMBER=6379
REDIS_SENTINEL_HOST=redis-sentinel
REDIS_SENTINEL_PORT_NUMBER=26379
REDIS_SENTINEL_MASTER_SET=mymaster
REDIS_SENTINEL_REPLICAS=3
REDIS_SENTINEL_QUORUM=2
REDIS_SENTINEL_DOWN_AFTER_MILLISECONDS=5000
REDIS_SENTINEL_FAILOVER_TIMEOUT=10000
REDIS_PROXY_REPLICAS=2
REDIS_PROXY_PUBLIC_PORT=16379

REDIS_CPU_RESERVATION=2.0
REDIS_CPU_LIMIT=4.0
REDIS_MEM_RESERVATION=4G
REDIS_MEM_LIMIT=8G
REDIS_SENTINEL_CPU_RESERVATION=0.25
REDIS_SENTINEL_CPU_LIMIT=0.5
REDIS_SENTINEL_MEM_RESERVATION=256M
REDIS_SENTINEL_MEM_LIMIT=512M
REDIS_SENTINEL_NODE_CONSTRAINT=node.labels.cloudreve.redis-sentinel==true
REDIS_PROXY_CPU_RESERVATION=0.5
REDIS_PROXY_CPU_LIMIT=1.0
REDIS_PROXY_MEM_RESERVATION=512M
REDIS_PROXY_MEM_LIMIT=1G
REDIS_PROXY_NODE_CONSTRAINT=node.labels.cloudreve.edge==true

REDIS_1_DATA_MOUNT_TYPE=bind
REDIS_1_DATA_MOUNT_SOURCE=/srv/cloudreve/redis/1
REDIS_2_DATA_MOUNT_TYPE=bind
REDIS_2_DATA_MOUNT_SOURCE=/srv/cloudreve/redis/2
REDIS_3_DATA_MOUNT_TYPE=bind
REDIS_3_DATA_MOUNT_SOURCE=/srv/cloudreve/redis/3

# 单节点 MinIO / ES 默认值在集群模式下不会被使用，这里保留 bind 示例
MINIO_DATA_MOUNT_TYPE=bind
MINIO_DATA_MOUNT_SOURCE=/srv/cloudreve/minio/single
ELASTICSEARCH_DATA_MOUNT_TYPE=bind
ELASTICSEARCH_DATA_MOUNT_SOURCE=/srv/cloudreve/elasticsearch/single

# MinIO 集群
MINIO_PROXY_REPLICAS=2
MINIO_PROXY_NODE_CONSTRAINT=node.labels.cloudreve.edge==true
MINIO_PROXY_CPU_RESERVATION=0.5
MINIO_PROXY_CPU_LIMIT=1.0
MINIO_PROXY_MEM_RESERVATION=512M
MINIO_PROXY_MEM_LIMIT=1G
MINIO_INIT_ENDPOINT=http://minio:9000
MINIO_INIT_REPLICAS=1
MINIO_INIT_NODE_CONSTRAINT=node.platform.os==linux
MINIO_INIT_CPU_RESERVATION=0.1
MINIO_INIT_CPU_LIMIT=0.25
MINIO_INIT_MEM_RESERVATION=128M
MINIO_INIT_MEM_LIMIT=256M
MINIO_INIT_INTERVAL_SECONDS=30
MINIO_DISTRIBUTED_NODES=minio-1,minio-2,minio-3,minio-4
MINIO_CLUSTER_NODE_CPU_RESERVATION=1.5
MINIO_CLUSTER_NODE_CPU_LIMIT=4.0
MINIO_CLUSTER_NODE_MEM_RESERVATION=4G
MINIO_CLUSTER_NODE_MEM_LIMIT=8G
MINIO_1_DATA_MOUNT_TYPE=bind
MINIO_1_DATA_MOUNT_SOURCE=/srv/cloudreve/minio/1
MINIO_2_DATA_MOUNT_TYPE=bind
MINIO_2_DATA_MOUNT_SOURCE=/srv/cloudreve/minio/2
MINIO_3_DATA_MOUNT_TYPE=bind
MINIO_3_DATA_MOUNT_SOURCE=/srv/cloudreve/minio/3
MINIO_4_DATA_MOUNT_TYPE=bind
MINIO_4_DATA_MOUNT_SOURCE=/srv/cloudreve/minio/4

# Elasticsearch 集群
ELASTICSEARCH_HTTP_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300
ELASTICSEARCH_PROXY_REPLICAS=2
ELASTICSEARCH_PROXY_NODE_CONSTRAINT=node.labels.cloudreve.edge==true
ELASTICSEARCH_PROXY_CPU_RESERVATION=0.5
ELASTICSEARCH_PROXY_CPU_LIMIT=1.0
ELASTICSEARCH_PROXY_MEM_RESERVATION=512M
ELASTICSEARCH_PROXY_MEM_LIMIT=1G
ELASTICSEARCH_CLUSTER_NAME=cloudreve-es
ELASTICSEARCH_DISCOVERY_SEED_HOSTS=tasks.elasticsearch-1,tasks.elasticsearch-2,tasks.elasticsearch-3
ELASTICSEARCH_CLUSTER_INITIAL_MASTER_NODES=elasticsearch-1,elasticsearch-2,elasticsearch-3
ELASTICSEARCH_CLUSTER_NODE_JAVA_OPTS="-Xms16g -Xmx16g"
ELASTICSEARCH_CLUSTER_NODE_CPU_RESERVATION=6.0
ELASTICSEARCH_CLUSTER_NODE_CPU_LIMIT=10.0
ELASTICSEARCH_CLUSTER_NODE_MEM_RESERVATION=24G
ELASTICSEARCH_CLUSTER_NODE_MEM_LIMIT=32G
ELASTICSEARCH_1_DATA_MOUNT_TYPE=bind
ELASTICSEARCH_1_DATA_MOUNT_SOURCE=/srv/cloudreve/elasticsearch/1
ELASTICSEARCH_2_DATA_MOUNT_TYPE=bind
ELASTICSEARCH_2_DATA_MOUNT_SOURCE=/srv/cloudreve/elasticsearch/2
ELASTICSEARCH_3_DATA_MOUNT_TYPE=bind
ELASTICSEARCH_3_DATA_MOUNT_SOURCE=/srv/cloudreve/elasticsearch/3

# Kafka 集群
KAFKA_PROXY_REPLICAS=2
KAFKA_PROXY_NODE_CONSTRAINT=node.labels.cloudreve.edge==true
KAFKA_PROXY_CPU_RESERVATION=0.5
KAFKA_PROXY_CPU_LIMIT=1.0
KAFKA_PROXY_MEM_RESERVATION=512M
KAFKA_PROXY_MEM_LIMIT=1G
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka-1:9093,2@kafka-2:9093,3@kafka-3:9093
KAFKA_1_ADVERTISED_LISTENER=kafka-1:9092
KAFKA_2_ADVERTISED_LISTENER=kafka-2:9092
KAFKA_3_ADVERTISED_LISTENER=kafka-3:9092
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_NUM_PARTITIONS=3
KAFKA_DEFAULT_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=3
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=3
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=2
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_CLUSTER_NODE_JVM_HEAP_OPTS="-Xms2g -Xmx2g"
KAFKA_CLUSTER_NODE_CPU_RESERVATION=2.0
KAFKA_CLUSTER_NODE_CPU_LIMIT=4.0
KAFKA_CLUSTER_NODE_MEM_RESERVATION=4G
KAFKA_CLUSTER_NODE_MEM_LIMIT=8G
KAFKA_1_DATA_MOUNT_TYPE=bind
KAFKA_1_DATA_MOUNT_SOURCE=/srv/cloudreve/kafka/1
KAFKA_2_DATA_MOUNT_TYPE=bind
KAFKA_2_DATA_MOUNT_SOURCE=/srv/cloudreve/kafka/2
KAFKA_3_DATA_MOUNT_TYPE=bind
KAFKA_3_DATA_MOUNT_SOURCE=/srv/cloudreve/kafka/3

KAFKA_UI_REPLICAS=1
KAFKA_UI_HTTP_PORT=18089
KAFKA_UI_CLUSTER_NAME=cloudreve-kafka
KAFKA_UI_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_UI_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_UI_DYNAMIC_CONFIG_ENABLED=false
KAFKA_UI_NODE_CONSTRAINT=node.labels.cloudreve.kafka-ui==true
KAFKA_UI_CPU_RESERVATION=0.5
KAFKA_UI_CPU_LIMIT=1.0
KAFKA_UI_MEM_RESERVATION=512M
KAFKA_UI_MEM_LIMIT=1G

# Tika
TIKA_HTTP_PORT=9998
TIKA_FONT_DIRS=/tika-fonts/custom
TIKA_FONT_DEBUG=0
TIKA_REPLICAS=2
TIKA_CPU_RESERVATION=2.0
TIKA_CPU_LIMIT=6.0
TIKA_MEM_RESERVATION=4G
TIKA_MEM_LIMIT=8G
TIKA_CUSTOM_FONTS_MOUNT_TYPE=bind
TIKA_CUSTOM_FONTS_MOUNT_SOURCE=/srv/cloudreve/tika-fonts
TIKA_NODE_CONSTRAINT=node.labels.cloudreve.tika==true

# 节点约束
PG_NODE_1_CONSTRAINT=node.labels.cloudreve.pg1==true
PG_NODE_2_CONSTRAINT=node.labels.cloudreve.pg2==true
PG_NODE_3_CONSTRAINT=node.labels.cloudreve.pg3==true
REDIS_NODE_1_CONSTRAINT=node.labels.cloudreve.redis1==true
REDIS_NODE_2_CONSTRAINT=node.labels.cloudreve.redis2==true
REDIS_NODE_3_CONSTRAINT=node.labels.cloudreve.redis3==true
MINIO_NODE_1_CONSTRAINT=node.labels.cloudreve.minio1==true
MINIO_NODE_2_CONSTRAINT=node.labels.cloudreve.minio2==true
MINIO_NODE_3_CONSTRAINT=node.labels.cloudreve.minio3==true
MINIO_NODE_4_CONSTRAINT=node.labels.cloudreve.minio4==true
ELASTICSEARCH_NODE_1_CONSTRAINT=node.labels.cloudreve.es1==true
ELASTICSEARCH_NODE_2_CONSTRAINT=node.labels.cloudreve.es2==true
ELASTICSEARCH_NODE_3_CONSTRAINT=node.labels.cloudreve.es3==true
KAFKA_NODE_1_CONSTRAINT=node.labels.cloudreve.kafka1==true
KAFKA_NODE_2_CONSTRAINT=node.labels.cloudreve.kafka2==true
KAFKA_NODE_3_CONSTRAINT=node.labels.cloudreve.kafka3==true
