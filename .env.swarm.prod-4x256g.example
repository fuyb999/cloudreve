# Cloudreve Swarm 生产基线：
# - 1 个 manager + 3 个 worker
# - 每台 256GB 内存 / 64 线程
# - 目标：约 1000w 级元数据量，充分利用 4 台机器，同时给 OS、页缓存、故障迁移和索引重建保留余量
#
# 用法：
#   cp .env.swarm.prod-4x256g.example .env.swarm
#
# 推荐主机名：
# - 建议最后一位直接使用服务器 IP 的最后一位，方便在 Swarm 里快速定位机器
# - cr-prod-mgr-11
# - cr-prod-wkr-12
# - cr-prod-wkr-13
# - cr-prod-wkr-14
#
# 推荐标签分布：
# - cr-prod-mgr-11：cloudreve.master, cloudreve.edge, cloudreve.registry, cloudreve.minio1, cloudreve.tika, cloudreve.auth-web, cloudreve.onlyoffice, cloudreve.onlyoffice-rabbitmq, cloudreve.kafka-ui
# - cr-prod-wkr-12：cloudreve.slave, cloudreve.edge, cloudreve.pg1, cloudreve.redis1, cloudreve.redis-sentinel, cloudreve.es1, cloudreve.kafka1, cloudreve.minio2, cloudreve.tika, cloudreve.auth-web, cloudreve.auth-backend, cloudreve.onlyoffice
# - cr-prod-wkr-13：cloudreve.slave, cloudreve.edge, cloudreve.pg2, cloudreve.redis2, cloudreve.redis-sentinel, cloudreve.es2, cloudreve.kafka2, cloudreve.minio3, cloudreve.tika, cloudreve.auth-web, cloudreve.auth-backend, cloudreve.onlyoffice
# - cr-prod-wkr-14：cloudreve.slave, cloudreve.edge, cloudreve.pg3, cloudreve.redis3, cloudreve.redis-sentinel, cloudreve.es3, cloudreve.kafka3, cloudreve.minio4, cloudreve.tika, cloudreve.auth-web, cloudreve.auth-backend, cloudreve.onlyoffice
# - 所有 4 台都作为 `cloudreve.edge` 承接 Swarm published port 后端，外部统一走 VIP/LB。

# 镜像版本与镜像来源模式
# - `SWARM_IMAGE_SOURCE=local`：
#   `deploy-stack.sh` 会优先使用 `*_LOCAL_IMAGE`
# - `SWARM_IMAGE_SOURCE=remote`：
#   `deploy-stack.sh` 会优先使用 `*_REMOTE_IMAGE`
# - 生产默认走 `remote`，也就是固定 manager 上的私有仓库
# - `registry` 自身是引导镜像，remote 仍保持公共可拉取地址，不能指回自身
# - `cloudreve-slave` 与 `cloudreve-master` 复用同一份镜像，所以 remote 地址相同
# - 截至 2026-04-11，已用 `docker manifest inspect` 复核：
#   PostgreSQL Repmgr / Pgpool / Redis / MinIO 这些固定版本 tag 在 Docker Hub 上仍以 `bitnamilegacy/*` 可拉取为准
SWARM_IMAGE_SOURCE=remote
PRIVATE_REGISTRY_STACK_NAME=cloudreve-registry
PRIVATE_REGISTRY_LOCAL_IMAGE=registry:2.8.3
PRIVATE_REGISTRY_REMOTE_IMAGE=registry:2.8.3
PRIVATE_REGISTRY_IMAGE="${PRIVATE_REGISTRY_LOCAL_IMAGE}"
PRIVATE_REGISTRY_SCHEME=http
PRIVATE_REGISTRY_ADDR=cr-prod-mgr-11:15000
PRIVATE_REGISTRY_SERVER_NAME=cr-prod-mgr-11
PRIVATE_REGISTRY_REPLICAS=1
PRIVATE_REGISTRY_HTTP_PORT=15000
PRIVATE_REGISTRY_DELETE_ENABLED=true
PRIVATE_REGISTRY_DATA_MOUNT_TYPE=bind
PRIVATE_REGISTRY_DATA_MOUNT_SOURCE=/srv/cloudreve/registry
PRIVATE_REGISTRY_NODE_CONSTRAINT=node.labels.cloudreve.registry==true
PRIVATE_REGISTRY_CPU_RESERVATION=0.5
PRIVATE_REGISTRY_CPU_LIMIT=2.0
PRIVATE_REGISTRY_MEM_RESERVATION=512M
PRIVATE_REGISTRY_MEM_LIMIT=2G
PRIVATE_REGISTRY_IMAGE_KEYS=CLOUDREVE,NGINX,TIKA,AUTHVERSE_WEB,AUTHVERSE_BACKEND,AUTHVERSE_WEB_BUILDER_BASE,AUTHVERSE_WEB_RUNTIME_BASE,AUTHVERSE_BACKEND_BUILDER_BASE,AUTHVERSE_BACKEND_RUNTIME_BASE,POSTGRESQL_REPMGR,PGPOOL,REDIS,REDIS_SENTINEL,REDIS_PROXY,MINIO,MINIO_PROXY,ELASTICSEARCH,ELASTICSEARCH_PROXY,KAFKA,KAFKA_PROXY,KAFKA_UI,ONLYOFFICE,ONLYOFFICE_RABBITMQ
CLOUDREVE_LOCAL_IMAGE=cloudreve/cloudreve:4.15.0
CLOUDREVE_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/cloudreve/cloudreve:4.15.0"
CLOUDREVE_IMAGE="${CLOUDREVE_REMOTE_IMAGE}"
CLOUDREVE_SLAVE_LOCAL_IMAGE=cloudreve/cloudreve:4.15.0
CLOUDREVE_SLAVE_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/cloudreve/cloudreve:4.15.0"
CLOUDREVE_SLAVE_IMAGE="${CLOUDREVE_SLAVE_REMOTE_IMAGE}"
NGINX_LOCAL_IMAGE=nginx:1.27-alpine
NGINX_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/nginx:1.27-alpine"
NGINX_IMAGE="${NGINX_REMOTE_IMAGE}"
TIKA_LOCAL_IMAGE=cloudreve/tika:3.2.3.0-full-unrar-charset
TIKA_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/cloudreve/tika:3.2.3.0-full-unrar-charset"
TIKA_IMAGE="${TIKA_REMOTE_IMAGE}"
AUTHVERSE_WEB_LOCAL_IMAGE=authverse/authverse-web:2024-local
AUTHVERSE_WEB_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/authverse/authverse-web:2024-local"
AUTHVERSE_WEB_IMAGE="${AUTHVERSE_WEB_REMOTE_IMAGE}"
AUTHVERSE_BACKEND_LOCAL_IMAGE=authverse/authverse-backend:2024-local
AUTHVERSE_BACKEND_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/authverse/authverse-backend:2024-local"
AUTHVERSE_BACKEND_IMAGE="${AUTHVERSE_BACKEND_REMOTE_IMAGE}"
AUTHVERSE_WEB_BUILDER_BASE_LOCAL_IMAGE=node:22.14.0-alpine3.21
AUTHVERSE_WEB_BUILDER_BASE_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/node:22.14.0-alpine3.21"
AUTHVERSE_WEB_BUILDER_BASE_IMAGE="${AUTHVERSE_WEB_BUILDER_BASE_REMOTE_IMAGE}"
AUTHVERSE_WEB_RUNTIME_BASE_LOCAL_IMAGE=nginx:1.27.5-alpine
AUTHVERSE_WEB_RUNTIME_BASE_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/nginx:1.27.5-alpine"
AUTHVERSE_WEB_RUNTIME_BASE_IMAGE="${AUTHVERSE_WEB_RUNTIME_BASE_REMOTE_IMAGE}"
AUTHVERSE_BACKEND_BUILDER_BASE_LOCAL_IMAGE=maven:3.9.9-eclipse-temurin-21
AUTHVERSE_BACKEND_BUILDER_BASE_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/maven:3.9.9-eclipse-temurin-21"
AUTHVERSE_BACKEND_BUILDER_BASE_IMAGE="${AUTHVERSE_BACKEND_BUILDER_BASE_REMOTE_IMAGE}"
AUTHVERSE_BACKEND_RUNTIME_BASE_LOCAL_IMAGE=eclipse-temurin:21-jre-jammy
AUTHVERSE_BACKEND_RUNTIME_BASE_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/eclipse-temurin:21-jre-jammy"
AUTHVERSE_BACKEND_RUNTIME_BASE_IMAGE="${AUTHVERSE_BACKEND_RUNTIME_BASE_REMOTE_IMAGE}"
POSTGRESQL_REPMGR_LOCAL_IMAGE=bitnamilegacy/postgresql-repmgr:17.6.0-debian-12-r2
POSTGRESQL_REPMGR_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/bitnamilegacy/postgresql-repmgr:17.6.0-debian-12-r2"
POSTGRESQL_REPMGR_IMAGE="${POSTGRESQL_REPMGR_REMOTE_IMAGE}"
POSTGRES_INIT_IMAGE="${POSTGRESQL_REPMGR_REMOTE_IMAGE}"
PGPOOL_LOCAL_IMAGE=bitnamilegacy/pgpool:4.6.3-debian-12-r0
PGPOOL_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/bitnamilegacy/pgpool:4.6.3-debian-12-r0"
PGPOOL_IMAGE="${PGPOOL_REMOTE_IMAGE}"
REDIS_LOCAL_IMAGE=bitnamilegacy/redis:8.2.1-debian-12-r0
REDIS_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/bitnamilegacy/redis:8.2.1-debian-12-r0"
REDIS_IMAGE="${REDIS_REMOTE_IMAGE}"
REDIS_SENTINEL_LOCAL_IMAGE=bitnamilegacy/redis-sentinel:8.2.1-debian-12-r0
REDIS_SENTINEL_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/bitnamilegacy/redis-sentinel:8.2.1-debian-12-r0"
REDIS_SENTINEL_IMAGE="${REDIS_SENTINEL_REMOTE_IMAGE}"
REDIS_PROXY_LOCAL_IMAGE=haproxy:3.0-alpine
REDIS_PROXY_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/haproxy:3.0-alpine"
REDIS_PROXY_IMAGE="${REDIS_PROXY_REMOTE_IMAGE}"
MINIO_LOCAL_IMAGE=bitnamilegacy/minio:2024.10.2-debian-12-r0
MINIO_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/bitnamilegacy/minio:2024.10.2-debian-12-r0"
MINIO_IMAGE="${MINIO_REMOTE_IMAGE}"
MINIO_PROXY_LOCAL_IMAGE=haproxy:3.0-alpine
MINIO_PROXY_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/haproxy:3.0-alpine"
MINIO_PROXY_IMAGE="${MINIO_PROXY_REMOTE_IMAGE}"
ELASTICSEARCH_LOCAL_IMAGE=elasticsearch:8.12.2
ELASTICSEARCH_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/elasticsearch:8.12.2"
ELASTICSEARCH_IMAGE="${ELASTICSEARCH_REMOTE_IMAGE}"
ELASTICSEARCH_PROXY_LOCAL_IMAGE=haproxy:3.0-alpine
ELASTICSEARCH_PROXY_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/haproxy:3.0-alpine"
ELASTICSEARCH_PROXY_IMAGE="${ELASTICSEARCH_PROXY_REMOTE_IMAGE}"
KAFKA_LOCAL_IMAGE=apache/kafka:4.2.0
KAFKA_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/apache/kafka:4.2.0"
KAFKA_IMAGE="${KAFKA_REMOTE_IMAGE}"
KAFKA_PROXY_LOCAL_IMAGE=haproxy:3.0-alpine
KAFKA_PROXY_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/haproxy:3.0-alpine"
KAFKA_PROXY_IMAGE="${KAFKA_PROXY_REMOTE_IMAGE}"
KAFKA_UI_LOCAL_IMAGE=provectuslabs/kafka-ui:v0.7.2
KAFKA_UI_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/provectuslabs/kafka-ui:v0.7.2"
KAFKA_UI_IMAGE="${KAFKA_UI_REMOTE_IMAGE}"
ONLYOFFICE_LOCAL_IMAGE=onlyoffice/documentserver:8.2.2
ONLYOFFICE_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/onlyoffice/documentserver:8.2.2"
ONLYOFFICE_IMAGE="${ONLYOFFICE_REMOTE_IMAGE}"
ONLYOFFICE_RABBITMQ_LOCAL_IMAGE=rabbitmq:3.13.7-alpine
ONLYOFFICE_RABBITMQ_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/rabbitmq:3.13.7-alpine"
ONLYOFFICE_RABBITMQ_IMAGE="${ONLYOFFICE_RABBITMQ_REMOTE_IMAGE}"

# 网络与集群型基础设施
# - 生产多栈部署时，每类服务都是独立 stack。
# - 所有 stack 共享同一个外部 overlay 网络，跨 stack 调用统一使用 `stack_service` 全名。
SWARM_SHARED_NETWORK=cloudreve-prod_backend
FOUNDATION_STACK_NAME=cloudreve-prod-foundation
INFRA_STACK_NAME=cloudreve-prod-infra
CLOUDREVE_STACK_NAME=cloudreve-prod-app
AUTHVERSE_STACK_NAME=authverse-prod
CLOUDREVE_FOUNDATION_SERVICE_PREFIX="${FOUNDATION_STACK_NAME}_"
CLOUDREVE_INFRA_SERVICE_PREFIX="${INFRA_STACK_NAME}_"
CLOUDREVE_APP_SERVICE_PREFIX="${CLOUDREVE_STACK_NAME}_"
CLOUDREVE_BACKEND_SUBNET=10.20.0.0/24
SWARM_ROLLING_ORDER=start-first
SWARM_TIMEZONE=Asia/Shanghai
SWARM_LOCALTIME_MOUNT_TYPE=bind
SWARM_LOCALTIME_MOUNT_SOURCE=/etc/localtime
SWARM_LOGGING_DRIVER=json-file
SWARM_LOGGING_MAX_SIZE=20m
SWARM_LOGGING_MAX_FILE=5
SWARM_LOGGING_COMPRESS=true
SWARM_PKI_MOUNT_TYPE=bind
SWARM_PKI_MOUNT_SOURCE=/srv/cloudreve/pki
SWARM_PKI_MOUNT_TARGET=/run/swarm-pki
SWARM_CA_COMMON_NAME="Cloudreve Swarm Root CA"
SWARM_CA_VALID_DAYS=3650
SWARM_CERT_VALID_DAYS=825
PRIVATE_REGISTRY_CA_FILE="${SWARM_PKI_MOUNT_SOURCE}/ca/ca.crt"

# 对外统一四层 VIP/LB
# - 这里的 VIP 端口是客户端访问端口，后端端口仍然是各 Swarm service 的 published port。
# - 默认使用 2xxxx 端口，避免 HAProxy/Keepalived 与本机 Docker published port 抢同一个端口。
# - 如果你使用独立 LB 机器，也可以把这些 VIP 端口改回和后端端口一致。
SWARM_LB_VIP=10.10.0.100
SWARM_LB_VIP_CIDR=24
SWARM_LB_INTERFACE=eth0
SWARM_LB_BIND_ADDRESS="${SWARM_LB_VIP}"
SWARM_LB_EDGE_NODES=cr-prod-mgr-11=10.10.0.11,cr-prod-wkr-12=10.10.0.12,cr-prod-wkr-13=10.10.0.13,cr-prod-wkr-14=10.10.0.14
SWARM_LB_BALANCE=roundrobin
SWARM_LB_HAPROXY_MAXCONN=200000
SWARM_LB_CONNECT_TIMEOUT=5s
SWARM_LB_CLIENT_TIMEOUT=1h
SWARM_LB_SERVER_TIMEOUT=1h
SWARM_LB_STATS_ENABLED=true
SWARM_LB_STATS_PORT=28404
SWARM_LB_STATS_USER=cloudreve
SWARM_LB_STATS_PASSWORD=replace-with-strong-lb-stats-password
SWARM_LB_VIRTUAL_ROUTER_ID=81
SWARM_LB_AUTH_PASS=vipauth1
SWARM_LB_ADVERT_INT=1
SWARM_LB_STATE=BACKUP
SWARM_LB_PRIORITY=100
SWARM_LB_CLOUDREVE_MASTER_PORT=28081
SWARM_LB_CLOUDREVE_MASTER_BACKEND_PORT=18081
SWARM_LB_CLOUDREVE_SLAVE_PORT=28082
SWARM_LB_CLOUDREVE_SLAVE_BACKEND_PORT=18082
SWARM_LB_AUTHVERSE_PORT=28080
SWARM_LB_AUTHVERSE_BACKEND_PORT=18080
SWARM_LB_ONLYOFFICE_PORT=28090
SWARM_LB_ONLYOFFICE_BACKEND_PORT=18090
SWARM_LB_TIKA_PORT=29998
SWARM_LB_TIKA_BACKEND_PORT=19998
SWARM_LB_MINIO_API_PORT=29000
SWARM_LB_MINIO_API_BACKEND_PORT=19000
SWARM_LB_MINIO_CONSOLE_PORT=29001
SWARM_LB_MINIO_CONSOLE_BACKEND_PORT=19001
SWARM_LB_ELASTICSEARCH_HTTP_PORT=29200
SWARM_LB_ELASTICSEARCH_HTTP_BACKEND_PORT=19200
SWARM_LB_ELASTICSEARCH_TRANSPORT_PORT=29300
SWARM_LB_ELASTICSEARCH_TRANSPORT_BACKEND_PORT=19300
SWARM_LB_KAFKA_UI_PORT=28089
SWARM_LB_KAFKA_UI_BACKEND_PORT=18089
SWARM_LB_PGPOOL_PORT=25432
SWARM_LB_PGPOOL_BACKEND_PORT=15432
SWARM_LB_REDIS_PORT=26379
SWARM_LB_REDIS_BACKEND_PORT=16379
SWARM_LB_INCLUDE_TIKA=true
SWARM_LB_INCLUDE_MINIO_CONSOLE=true
SWARM_LB_INCLUDE_ELASTICSEARCH_HTTP=true
SWARM_LB_INCLUDE_ELASTICSEARCH_TRANSPORT=false
SWARM_LB_INCLUDE_KAFKA_UI=true
SWARM_LB_INCLUDE_REDIS=true
SWARM_LB_INCLUDE_REGISTRY=false
SWARM_LB_REGISTRY_PORT=25000
SWARM_LB_REGISTRY_BACKEND_PORT=15000

# 对象存储初始化
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
MINIO_DEFAULT_BUCKETS=cloudreve
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

CR_INIT_DEFAULT_STORAGE=s3
CR_INIT_S3_ENDPOINT="http://${CLOUDREVE_INFRA_SERVICE_PREFIX}minio-internal:9000"
CR_INIT_S3_BUCKET=cloudreve
CR_INIT_S3_ACCESS_KEY=minio
CR_INIT_S3_SECRET_KEY=replace-with-strong-minio-password
CR_INIT_S3_REGION=us-east-1
CR_INIT_S3_FORCE_PATH_STYLE=true
CR_INIT_S3_RELAY=true
CR_INIT_S3_INTERNAL_PROXY=true
CR_INIT_S3_IS_PRIVATE=true
CR_INIT_S3_CHUNK_SIZE=26214400

# Kafka 全局配置默认保守关闭。
# 如果你明确要让 Cloudreve 直接使用栈内 Kafka，再改成 true。
CLOUDREVE_POSTGRES_HOST="${CLOUDREVE_FOUNDATION_SERVICE_PREFIX}pgpool-internal"
CLOUDREVE_REDIS_ENDPOINT="${CLOUDREVE_FOUNDATION_SERVICE_PREFIX}redis-proxy-internal:6379"
CLOUDREVE_REDIS_USE_TLS=false
CLOUDREVE_FTS_ELASTICSEARCH_ENDPOINT="http://${CLOUDREVE_INFRA_SERVICE_PREFIX}elasticsearch-internal:9200"
CLOUDREVE_FTS_TIKA_ENDPOINT="http://${CLOUDREVE_FOUNDATION_SERVICE_PREFIX}tika:9998"
CLOUDREVE_GLOBAL_KAFKA_ENABLED=false
CLOUDREVE_GLOBAL_KAFKA_BROKERS="${CLOUDREVE_INFRA_SERVICE_PREFIX}kafka:9092"
CLOUDREVE_GLOBAL_KAFKA_VERSION=3.7.0
CLOUDREVE_GLOBAL_KAFKA_CLIENT_ID=cloudreve
CLOUDREVE_GLOBAL_KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# 入口与主从
CLOUDREVE_SITE_URL=https://cloudreve.example.com
CLOUDREVE_SESSION_SECRET=replace-with-at-least-64-random-chars

CLOUDREVE_MASTER_RUNTIME_MOUNT_TYPE=bind
CLOUDREVE_MASTER_RUNTIME_MOUNT_SOURCE=/srv/cloudreve/runtime/master
CLOUDREVE_MASTER_NODE_CONSTRAINT=node.labels.cloudreve.master==true
CLOUDREVE_MASTER_REPLICAS=1
CLOUDREVE_MASTER_CPU_RESERVATION=4.0
CLOUDREVE_MASTER_CPU_LIMIT=12.0
CLOUDREVE_MASTER_MEM_RESERVATION=16G
CLOUDREVE_MASTER_MEM_LIMIT=32G

CLOUDREVE_MASTER_HTTP_PORT=18081
CLOUDREVE_MASTER_PROXY_REPLICAS=4
CLOUDREVE_MASTER_SERVER_NAME=cloudreve.example.com
CLOUDREVE_MASTER_TLS_EXTRA_SANS=
CLOUDREVE_MASTER_PROXY_CPU_RESERVATION=0.5
CLOUDREVE_MASTER_PROXY_CPU_LIMIT=2.0
CLOUDREVE_MASTER_PROXY_MEM_RESERVATION=512M
CLOUDREVE_MASTER_PROXY_MEM_LIMIT=1G
CLOUDREVE_MASTER_PROXY_NODE_CONSTRAINT=node.labels.cloudreve.edge==true

CLOUDREVE_SLAVE_SECRET=replace-with-cloudreve-admin-generated-slave-key-after-first-boot-0000
CLOUDREVE_SLAVE_RUNTIME_MOUNT_TYPE=bind
CLOUDREVE_SLAVE_RUNTIME_MOUNT_SOURCE=/srv/cloudreve/runtime/slave
CLOUDREVE_SLAVE_NODE_CONSTRAINT=node.labels.cloudreve.slave==true
CLOUDREVE_SLAVE_REPLICAS=3
CLOUDREVE_SLAVE_CPU_RESERVATION=3.0
CLOUDREVE_SLAVE_CPU_LIMIT=8.0
CLOUDREVE_SLAVE_MEM_RESERVATION=8G
CLOUDREVE_SLAVE_MEM_LIMIT=20G

CLOUDREVE_SLAVE_HTTP_PORT=18082
CLOUDREVE_SLAVE_PROXY_REPLICAS=4
CLOUDREVE_SLAVE_SERVER_NAME=slave-cloudreve.example.com
CLOUDREVE_SLAVE_TLS_EXTRA_SANS=
CLOUDREVE_SLAVE_PROXY_CPU_RESERVATION=0.5
CLOUDREVE_SLAVE_PROXY_CPU_LIMIT=2.0
CLOUDREVE_SLAVE_PROXY_MEM_RESERVATION=512M
CLOUDREVE_SLAVE_PROXY_MEM_LIMIT=1G
CLOUDREVE_SLAVE_PROXY_NODE_CONSTRAINT=node.labels.cloudreve.edge==true

# PostgreSQL
POSTGRESQL_USERNAME=cloudreve
POSTGRESQL_DATABASE=cloudreve
POSTGRESQL_PASSWORD=replace-with-strong-app-password
POSTGRESQL_POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRESQL_NUM_SYNCHRONOUS_REPLICAS=1
REPMGR_PASSWORD=replace-with-strong-repmgr-password
PGPOOL_REPLICAS=4
PGPOOL_ADMIN_USERNAME=admin
PGPOOL_ADMIN_PASSWORD=replace-with-strong-pgpool-admin-password
PGPOOL_PUBLIC_PORT=15432

POSTGRESQL_CPU_RESERVATION=8.0
POSTGRESQL_CPU_LIMIT=20.0
POSTGRESQL_MEM_RESERVATION=32G
POSTGRESQL_MEM_LIMIT=64G
PGPOOL_CPU_RESERVATION=1.0
PGPOOL_CPU_LIMIT=4.0
PGPOOL_MEM_RESERVATION=1G
PGPOOL_MEM_LIMIT=4G
PGPOOL_NODE_CONSTRAINT=node.labels.cloudreve.edge==true
PGPOOL_PUBLIC_REPLICAS=4
PGPOOL_PUBLIC_NODE_CONSTRAINT=node.labels.cloudreve.edge==true
PGPOOL_PUBLIC_CPU_RESERVATION=1.0
PGPOOL_PUBLIC_CPU_LIMIT=4.0
PGPOOL_PUBLIC_MEM_RESERVATION=1G
PGPOOL_PUBLIC_MEM_LIMIT=4G
PGPOOL_TLS_SERVER_NAME=pg.example.com

PG_1_DATA_MOUNT_TYPE=bind
PG_1_DATA_MOUNT_SOURCE=/srv/cloudreve/postgresql/1
PG_2_DATA_MOUNT_TYPE=bind
PG_2_DATA_MOUNT_SOURCE=/srv/cloudreve/postgresql/2
PG_3_DATA_MOUNT_TYPE=bind
PG_3_DATA_MOUNT_SOURCE=/srv/cloudreve/postgresql/3

# Redis
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_AOF_ENABLED=yes
REDIS_MASTER_HOST=redis-1
REDIS_MASTER_PORT_NUMBER=6379
REDIS_SENTINEL_HOST=redis-sentinel
REDIS_SENTINEL_PORT_NUMBER=26379
REDIS_SENTINEL_MASTER_SET=mymaster
REDIS_SENTINEL_REPLICAS=3
REDIS_SENTINEL_QUORUM=2
REDIS_SENTINEL_DOWN_AFTER_MILLISECONDS=5000
REDIS_SENTINEL_FAILOVER_TIMEOUT=10000
REDIS_PROXY_REPLICAS=4
REDIS_PROXY_PUBLIC_PORT=16379

REDIS_CPU_RESERVATION=3.0
REDIS_CPU_LIMIT=8.0
REDIS_MEM_RESERVATION=16G
REDIS_MEM_LIMIT=32G
REDIS_SENTINEL_CPU_RESERVATION=0.5
REDIS_SENTINEL_CPU_LIMIT=1.0
REDIS_SENTINEL_MEM_RESERVATION=512M
REDIS_SENTINEL_MEM_LIMIT=1G
REDIS_SENTINEL_NODE_CONSTRAINT=node.labels.cloudreve.redis-sentinel==true
REDIS_PROXY_CPU_RESERVATION=0.5
REDIS_PROXY_CPU_LIMIT=2.0
REDIS_PROXY_MEM_RESERVATION=256M
REDIS_PROXY_MEM_LIMIT=1G
REDIS_PROXY_NODE_CONSTRAINT=node.labels.cloudreve.edge==true
REDIS_PROXY_PUBLIC_REPLICAS=4
REDIS_PROXY_PUBLIC_NODE_CONSTRAINT=node.labels.cloudreve.edge==true
REDIS_PROXY_PUBLIC_CPU_RESERVATION=0.5
REDIS_PROXY_PUBLIC_CPU_LIMIT=2.0
REDIS_PROXY_PUBLIC_MEM_RESERVATION=256M
REDIS_PROXY_PUBLIC_MEM_LIMIT=1G
REDIS_PROXY_TLS_SERVER_NAME=redis.example.com

REDIS_1_DATA_MOUNT_TYPE=bind
REDIS_1_DATA_MOUNT_SOURCE=/srv/cloudreve/redis/1
REDIS_2_DATA_MOUNT_TYPE=bind
REDIS_2_DATA_MOUNT_SOURCE=/srv/cloudreve/redis/2
REDIS_3_DATA_MOUNT_TYPE=bind
REDIS_3_DATA_MOUNT_SOURCE=/srv/cloudreve/redis/3

# 统一认证
AUTHVERSE_SHARED_NETWORK="${SWARM_SHARED_NETWORK}"
AUTHVERSE_CLOUDREVE_SERVICE_PREFIX="${CLOUDREVE_APP_SERVICE_PREFIX}"
AUTHVERSE_PUBLIC_BASE_URL=https://auth.example.com
AUTHVERSE_HTTP_PORT=18080
AUTHVERSE_SERVER_NAME=auth.example.com
AUTHVERSE_TLS_EXTRA_SANS=
AUTHVERSE_CLOUDREVE_PUBLIC_BASE_URL="${CLOUDREVE_SITE_URL}"
AUTHVERSE_CLOUDREVE_INTERNAL_UPSTREAM="${CLOUDREVE_APP_SERVICE_PREFIX}cloudreve-master:5212"
AUTHVERSE_CLOUDREVE_HOST_HEADER=cloudreve.example.com

AUTHVERSE_POSTGRES_HOST="${CLOUDREVE_FOUNDATION_SERVICE_PREFIX}pgpool-internal"
AUTHVERSE_POSTGRES_PORT=5432
AUTHVERSE_DB_NAME=authverse
AUTHVERSE_DB_USERNAME="${POSTGRESQL_USERNAME}"
AUTHVERSE_DB_PASSWORD="${POSTGRESQL_PASSWORD}"
AUTHVERSE_DB_MASTER_URL="jdbc:postgresql://${AUTHVERSE_POSTGRES_HOST}:${AUTHVERSE_POSTGRES_PORT}/${AUTHVERSE_DB_NAME}"
AUTHVERSE_DB_SLAVE_URL="${AUTHVERSE_DB_MASTER_URL}"
AUTHVERSE_DB_SLAVE_USERNAME="${AUTHVERSE_DB_USERNAME}"
AUTHVERSE_DB_SLAVE_PASSWORD="${AUTHVERSE_DB_PASSWORD}"
AUTHVERSE_DB_ADMIN_USER=postgres
AUTHVERSE_DB_ADMIN_PASSWORD="${POSTGRESQL_POSTGRES_PASSWORD}"

AUTHVERSE_REDIS_HOST="${CLOUDREVE_FOUNDATION_SERVICE_PREFIX}redis-proxy-internal"
AUTHVERSE_REDIS_PORT=6379
AUTHVERSE_REDIS_PASSWORD="${REDIS_PASSWORD}"
AUTHVERSE_REDIS_DATABASE=0
AUTHVERSE_ELASTICSEARCH_URI="http://${CLOUDREVE_INFRA_SERVICE_PREFIX}elasticsearch-internal:9200"
AUTHVERSE_ELASTICSEARCH_ENABLED=true
AUTHVERSE_ELASTICSEARCH_CONNECTION_TIMEOUT=3s
AUTHVERSE_ELASTICSEARCH_SOCKET_TIMEOUT=10s
AUTHVERSE_ELASTICSEARCH_CONNECTION_REQUEST_TIMEOUT=3s

AUTHVERSE_TENANT_ENABLED=false
AUTHVERSE_DEFAULT_TENANT_NAME=统一认证
AUTHVERSE_SITE_TITLE=统一授权中心
AUTHVERSE_LOGIN_CAPTCHA_ENABLED=false
AUTHVERSE_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTHVERSE_WEB_BUILD_NODE_OPTIONS=--max-old-space-size=4096
AUTHVERSE_OIDC_ENABLED=true
AUTHVERSE_OIDC_RSA_AUTO_GENERATE=false
AUTHVERSE_OIDC_KEY_ID=oidc-rsa-key-prod
AUTHVERSE_OIDC_KEYS_MOUNT_TYPE=bind
AUTHVERSE_OIDC_KEYS_MOUNT_SOURCE=/srv/cloudreve/authverse/oidc
AUTHVERSE_OIDC_PRIVATE_KEY_PATH=file:/run/authverse/oidc/private.pem
AUTHVERSE_OIDC_PUBLIC_KEY_PATH=file:/run/authverse/oidc/public.pem
AUTHVERSE_TOKEN_CALLBACK_ENABLED=true
AUTHVERSE_TOKEN_CALLBACK_TIMEOUT_MS=5000
AUTHVERSE_TOKEN_CALLBACK_RETRY_TIMES=3
AUTHVERSE_TOKEN_CALLBACK_RETRY_INTERVAL_MS=1000
AUTHVERSE_WEBSOCKET_SENDER_TYPE=redis
AUTHVERSE_MAX_FILE_SIZE=64MB
AUTHVERSE_MAX_REQUEST_SIZE=128MB
AUTHVERSE_JAVA_OPTS="-Xms6g -Xmx12g -Djava.security.egd=file:/dev/./urandom"

AUTHVERSE_WEB_REPLICAS=4
AUTHVERSE_WEB_CPU_RESERVATION=0.5
AUTHVERSE_WEB_CPU_LIMIT=2.0
AUTHVERSE_WEB_MEM_RESERVATION=256M
AUTHVERSE_WEB_MEM_LIMIT=1G
AUTHVERSE_WEB_NODE_CONSTRAINT=node.labels.cloudreve.auth-web==true
AUTHVERSE_CLIENT_MAX_BODY_SIZE=0
AUTHVERSE_PROXY_READ_TIMEOUT=3600s
AUTHVERSE_PROXY_SEND_TIMEOUT=3600s

AUTHVERSE_BACKEND_REPLICAS=3
AUTHVERSE_BACKEND_CPU_RESERVATION=3.0
AUTHVERSE_BACKEND_CPU_LIMIT=8.0
AUTHVERSE_BACKEND_MEM_RESERVATION=8G
AUTHVERSE_BACKEND_MEM_LIMIT=20G
AUTHVERSE_BACKEND_NODE_CONSTRAINT=node.labels.cloudreve.auth-backend==true

# 单节点 MinIO / ES 默认值在集群模式下不会被使用，这里保留 bind 示例
MINIO_DATA_MOUNT_TYPE=bind
