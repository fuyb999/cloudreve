# Cloudreve Swarm 单节点用户测试基线：
# - 这份模板是从 `1 manager + 3 worker` 生产基线裁成的 1 台 Linux 版本
# - 目标是先把整套服务在单机上打通，适合用户验收、功能联调、上线前预演
# - 默认配合 `docker-compose.swarm.single.yml`
# - 默认直接使用私有仓库远程镜像
#
# 推荐主机名：
# - 建议延续“最后一位用 IP 最后一位”的命名习惯，例如：`cr-user-test-11`
# - 如果你不是直接在本机访问，请把下面 `127.0.0.1` 全部替换成真实机器 IP 或域名

# 镜像来源与版本。
SWARM_IMAGE_SOURCE=remote
PRIVATE_REGISTRY_STACK_NAME=cloudreve-registry-user-test
PRIVATE_REGISTRY_LOCAL_IMAGE=registry:2.8.3
PRIVATE_REGISTRY_REMOTE_IMAGE=registry:2.8.3
PRIVATE_REGISTRY_IMAGE="${PRIVATE_REGISTRY_LOCAL_IMAGE}"
PRIVATE_REGISTRY_SCHEME=http
PRIVATE_REGISTRY_ADDR=127.0.0.1:15000
PRIVATE_REGISTRY_SERVER_NAME=127.0.0.1
PRIVATE_REGISTRY_REPLICAS=1
PRIVATE_REGISTRY_HTTP_PORT=15000
PRIVATE_REGISTRY_DELETE_ENABLED=true
PRIVATE_REGISTRY_DATA_MOUNT_TYPE=bind
PRIVATE_REGISTRY_DATA_MOUNT_SOURCE=/srv/cloudreve-user-test/registry
PRIVATE_REGISTRY_NODE_CONSTRAINT=node.platform.os==linux
PRIVATE_REGISTRY_CPU_RESERVATION=0.10
PRIVATE_REGISTRY_CPU_LIMIT=0.50
PRIVATE_REGISTRY_MEM_RESERVATION=128M
PRIVATE_REGISTRY_MEM_LIMIT=256M
PRIVATE_REGISTRY_IMAGE_KEYS=CLOUDREVE,NGINX,TIKA,AUTHVERSE_WEB,AUTHVERSE_BACKEND,AUTHVERSE_WEB_BUILDER_BASE,AUTHVERSE_WEB_RUNTIME_BASE,AUTHVERSE_BACKEND_BUILDER_BASE,AUTHVERSE_BACKEND_RUNTIME_BASE,POSTGRESQL_REPMGR,PGPOOL,REDIS,REDIS_PROXY,MINIO,MINIO_PROXY,ELASTICSEARCH,ELASTICSEARCH_PROXY,KAFKA,KAFKA_PROXY,KAFKA_UI,ONLYOFFICE,ONLYOFFICE_RABBITMQ

CLOUDREVE_LOCAL_IMAGE=cloudreve/cloudreve:4.15.0
CLOUDREVE_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/cloudreve/cloudreve:4.15.0"
CLOUDREVE_IMAGE="${CLOUDREVE_REMOTE_IMAGE}"
CLOUDREVE_SLAVE_LOCAL_IMAGE=cloudreve/cloudreve:4.15.0
CLOUDREVE_SLAVE_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/cloudreve/cloudreve:4.15.0"
CLOUDREVE_SLAVE_IMAGE="${CLOUDREVE_SLAVE_REMOTE_IMAGE}"
NGINX_LOCAL_IMAGE=nginx:1.27-alpine
NGINX_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/nginx:1.27-alpine"
NGINX_IMAGE="${NGINX_REMOTE_IMAGE}"
TIKA_LOCAL_IMAGE=cloudreve/tika:3.2.3.0-full-unrar-charset
TIKA_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/cloudreve/tika:3.2.3.0-full-unrar-charset"
TIKA_IMAGE="${TIKA_REMOTE_IMAGE}"
AUTHVERSE_WEB_LOCAL_IMAGE=authverse/authverse-web:2024-local
AUTHVERSE_WEB_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/authverse/authverse-web:2024-local"
AUTHVERSE_WEB_IMAGE="${AUTHVERSE_WEB_REMOTE_IMAGE}"
AUTHVERSE_BACKEND_LOCAL_IMAGE=authverse/authverse-backend:2024-local
AUTHVERSE_BACKEND_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/authverse/authverse-backend:2024-local"
AUTHVERSE_BACKEND_IMAGE="${AUTHVERSE_BACKEND_REMOTE_IMAGE}"
AUTHVERSE_WEB_BUILDER_BASE_LOCAL_IMAGE=node:22.14.0-alpine3.21
AUTHVERSE_WEB_BUILDER_BASE_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/node:22.14.0-alpine3.21"
AUTHVERSE_WEB_BUILDER_BASE_IMAGE="${AUTHVERSE_WEB_BUILDER_BASE_REMOTE_IMAGE}"
AUTHVERSE_WEB_RUNTIME_BASE_LOCAL_IMAGE=nginx:1.27.5-alpine
AUTHVERSE_WEB_RUNTIME_BASE_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/nginx:1.27.5-alpine"
AUTHVERSE_WEB_RUNTIME_BASE_IMAGE="${AUTHVERSE_WEB_RUNTIME_BASE_REMOTE_IMAGE}"
AUTHVERSE_BACKEND_BUILDER_BASE_LOCAL_IMAGE=maven:3.9.9-eclipse-temurin-21
AUTHVERSE_BACKEND_BUILDER_BASE_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/maven:3.9.9-eclipse-temurin-21"
AUTHVERSE_BACKEND_BUILDER_BASE_IMAGE="${AUTHVERSE_BACKEND_BUILDER_BASE_REMOTE_IMAGE}"
AUTHVERSE_BACKEND_RUNTIME_BASE_LOCAL_IMAGE=eclipse-temurin:21-jre-jammy
AUTHVERSE_BACKEND_RUNTIME_BASE_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/eclipse-temurin:21-jre-jammy"
AUTHVERSE_BACKEND_RUNTIME_BASE_IMAGE="${AUTHVERSE_BACKEND_RUNTIME_BASE_REMOTE_IMAGE}"
POSTGRESQL_REPMGR_LOCAL_IMAGE=bitnamilegacy/postgresql-repmgr:17.6.0-debian-12-r2
POSTGRESQL_REPMGR_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/bitnamilegacy/postgresql-repmgr:17.6.0-debian-12-r2"
POSTGRESQL_REPMGR_IMAGE="${POSTGRESQL_REPMGR_REMOTE_IMAGE}"
POSTGRES_INIT_IMAGE="${POSTGRESQL_REPMGR_REMOTE_IMAGE}"
PGPOOL_LOCAL_IMAGE=bitnamilegacy/pgpool:4.6.3-debian-12-r0
PGPOOL_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/bitnamilegacy/pgpool:4.6.3-debian-12-r0"
PGPOOL_IMAGE="${PGPOOL_REMOTE_IMAGE}"
REDIS_LOCAL_IMAGE=bitnamilegacy/redis:8.2.1-debian-12-r0
REDIS_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/bitnamilegacy/redis:8.2.1-debian-12-r0"
REDIS_IMAGE="${REDIS_REMOTE_IMAGE}"
REDIS_PROXY_LOCAL_IMAGE=haproxy:3.0-alpine
REDIS_PROXY_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/haproxy:3.0-alpine"
REDIS_PROXY_IMAGE="${REDIS_PROXY_REMOTE_IMAGE}"
MINIO_LOCAL_IMAGE=bitnamilegacy/minio:2024.10.2-debian-12-r0
MINIO_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/bitnamilegacy/minio:2024.10.2-debian-12-r0"
MINIO_IMAGE="${MINIO_REMOTE_IMAGE}"
MINIO_PROXY_LOCAL_IMAGE=haproxy:3.0-alpine
MINIO_PROXY_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/haproxy:3.0-alpine"
MINIO_PROXY_IMAGE="${MINIO_PROXY_REMOTE_IMAGE}"
ELASTICSEARCH_LOCAL_IMAGE=elasticsearch:8.12.2
ELASTICSEARCH_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/elasticsearch:8.12.2"
ELASTICSEARCH_IMAGE="${ELASTICSEARCH_REMOTE_IMAGE}"
ELASTICSEARCH_PROXY_LOCAL_IMAGE=haproxy:3.0-alpine
ELASTICSEARCH_PROXY_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/haproxy:3.0-alpine"
ELASTICSEARCH_PROXY_IMAGE="${ELASTICSEARCH_PROXY_REMOTE_IMAGE}"
KAFKA_LOCAL_IMAGE=apache/kafka:4.2.0
KAFKA_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/apache/kafka:4.2.0"
KAFKA_IMAGE="${KAFKA_REMOTE_IMAGE}"
KAFKA_PROXY_LOCAL_IMAGE=haproxy:3.0-alpine
KAFKA_PROXY_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/haproxy:3.0-alpine"
KAFKA_PROXY_IMAGE="${KAFKA_PROXY_REMOTE_IMAGE}"
KAFKA_UI_LOCAL_IMAGE=provectuslabs/kafka-ui:v0.7.2
KAFKA_UI_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/provectuslabs/kafka-ui:v0.7.2"
KAFKA_UI_IMAGE="${KAFKA_UI_REMOTE_IMAGE}"
ONLYOFFICE_LOCAL_IMAGE=onlyoffice/documentserver:8.2.2
ONLYOFFICE_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/onlyoffice/documentserver:8.2.2"
ONLYOFFICE_IMAGE="${ONLYOFFICE_REMOTE_IMAGE}"
ONLYOFFICE_RABBITMQ_LOCAL_IMAGE=rabbitmq:3.13.7-alpine
ONLYOFFICE_RABBITMQ_REMOTE_IMAGE="${PRIVATE_REGISTRY_ADDR}/rabbitmq:3.13.7-alpine"
ONLYOFFICE_RABBITMQ_IMAGE="${ONLYOFFICE_RABBITMQ_REMOTE_IMAGE}"

# 网络、时区、日志与证书。
CLOUDREVE_STACK_NAME=cloudreve-user-test
AUTHVERSE_STACK_NAME=authverse-user-test
CLOUDREVE_BACKEND_SUBNET=10.21.0.0/24
SWARM_ROLLING_ORDER=stop-first
SWARM_TIMEZONE=Asia/Shanghai
SWARM_LOCALTIME_MOUNT_TYPE=bind
SWARM_LOCALTIME_MOUNT_SOURCE=/etc/localtime
SWARM_LOGGING_DRIVER=json-file
SWARM_LOGGING_MAX_SIZE=20m
SWARM_LOGGING_MAX_FILE=5
SWARM_LOGGING_COMPRESS=true
SWARM_PKI_MOUNT_TYPE=bind
SWARM_PKI_MOUNT_SOURCE=/srv/cloudreve-user-test/pki
SWARM_PKI_MOUNT_TARGET=/run/swarm-pki
SWARM_CA_COMMON_NAME="Cloudreve Swarm User Test Root CA"
SWARM_CA_VALID_DAYS=3650
SWARM_CERT_VALID_DAYS=825
SWARM_TRUSTSTORE_PASSWORD=changeit
PRIVATE_REGISTRY_CA_FILE="${SWARM_PKI_MOUNT_SOURCE}/ca/ca.crt"

# 单节点对象存储与默认存储策略。
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
MINIO_DEFAULT_BUCKETS=cloudreve
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_INIT_ENDPOINT=https://minio:9000
MINIO_INIT_CA_FILE="${SWARM_PKI_MOUNT_TARGET}/ca/ca.crt"
MINIO_PUBLIC_TLS_EXTRA_SANS=127.0.0.1

CR_INIT_DEFAULT_STORAGE=s3
CR_INIT_S3_ENDPOINT=https://minio:9000
CR_INIT_S3_BUCKET=cloudreve
CR_INIT_S3_ACCESS_KEY=minio
CR_INIT_S3_SECRET_KEY=replace-with-strong-minio-password
CR_INIT_S3_REGION=us-east-1
CR_INIT_S3_FORCE_PATH_STYLE=true
CR_INIT_S3_RELAY=true
CR_INIT_S3_INTERNAL_PROXY=true
CR_INIT_S3_IS_PRIVATE=true
CR_INIT_S3_CHUNK_SIZE=26214400
CLOUDREVE_CA_CERT_FILE="${SWARM_PKI_MOUNT_TARGET}/ca/ca.crt"
CLOUDREVE_CA_CERT_DIR="${SWARM_PKI_MOUNT_TARGET}/ca"
CLOUDREVE_REDIS_ENDPOINT=redis-1:6379
CLOUDREVE_REDIS_USE_TLS=false
CLOUDREVE_REDIS_TLS_SKIP_VERIFY=false

# 可选 Kafka 全局配置，默认保守关闭。
CLOUDREVE_GLOBAL_KAFKA_ENABLED=false
CLOUDREVE_GLOBAL_KAFKA_BROKERS=kafka:9092
CLOUDREVE_GLOBAL_KAFKA_VERSION=3.7.0
CLOUDREVE_GLOBAL_KAFKA_CLIENT_ID=cloudreve-user-test
CLOUDREVE_GLOBAL_KAFKA_TLS_MODE=internal-plaintext
CLOUDREVE_GLOBAL_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
CLOUDREVE_GLOBAL_KAFKA_TLS_SKIP_VERIFY=false
CLOUDREVE_GLOBAL_KAFKA_TLS_SERVER_NAME=kafka
CLOUDREVE_GLOBAL_KAFKA_TLS_CA_PATH=/run/swarm-pki/ca/ca.crt
CLOUDREVE_GLOBAL_KAFKA_TLS_CERT_PATH=
CLOUDREVE_GLOBAL_KAFKA_TLS_KEY_PATH=
CLOUDREVE_GLOBAL_KAFKA_SASL_MECHANISM=PLAIN
CLOUDREVE_GLOBAL_KAFKA_SASL_USERNAME=
CLOUDREVE_GLOBAL_KAFKA_SASL_PASSWORD=
CLOUDREVE_GLOBAL_KAFKA_SASL_HANDSHAKE=true

# Cloudreve 主站。
CLOUDREVE_SITE_URL=https://127.0.0.1:18081
CLOUDREVE_SESSION_SECRET=replace-with-at-least-64-random-chars
CLOUDREVE_MASTER_RUNTIME_MOUNT_TYPE=bind
CLOUDREVE_MASTER_RUNTIME_MOUNT_SOURCE=/srv/cloudreve-user-test/runtime/master
CLOUDREVE_MASTER_NODE_CONSTRAINT=node.platform.os==linux
CLOUDREVE_MASTER_CPU_RESERVATION=0.25
CLOUDREVE_MASTER_CPU_LIMIT=1.0
CLOUDREVE_MASTER_MEM_RESERVATION=768M
CLOUDREVE_MASTER_MEM_LIMIT=2G
CLOUDREVE_MASTER_HTTP_PORT=18081
CLOUDREVE_MASTER_SERVER_NAME=_
CLOUDREVE_MASTER_TLS_EXTRA_SANS=127.0.0.1
CLOUDREVE_MASTER_CLIENT_MAX_BODY_SIZE=0
CLOUDREVE_MASTER_PROXY_READ_TIMEOUT=3600s
CLOUDREVE_MASTER_PROXY_SEND_TIMEOUT=3600s
CLOUDREVE_MASTER_PROXY_CPU_RESERVATION=0.05
CLOUDREVE_MASTER_PROXY_CPU_LIMIT=0.50
CLOUDREVE_MASTER_PROXY_MEM_RESERVATION=128M
CLOUDREVE_MASTER_PROXY_MEM_LIMIT=512M

# PostgreSQL 单节点。
POSTGRESQL_USERNAME=cloudreve
POSTGRESQL_DATABASE=cloudreve
POSTGRESQL_PASSWORD=replace-with-strong-app-password
POSTGRESQL_POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRESQL_MAX_CONNECTIONS=200
POSTGRESQL_SINGLE_NODE_NUM_SYNCHRONOUS_REPLICAS=0
REPMGR_SINGLE_NODE_PARTNER_NODES=postgresql-1
REPMGR_PASSWORD=replace-with-strong-repmgr-password
PGPOOL_ADMIN_USERNAME=admin
PGPOOL_ADMIN_PASSWORD=replace-with-strong-pgpool-admin-password
PGPOOL_PUBLIC_PORT=15432
PGPOOL_NUM_INIT_CHILDREN=32
PGPOOL_RESERVED_CONNECTIONS=5
PGPOOL_MAX_POOL=10
PGPOOL_CHILD_MAX_CONNECTIONS=0
PGPOOL_CHILD_LIFE_TIME=300
PGPOOL_CONNECTION_LIFE_TIME=600
PGPOOL_CLIENT_IDLE_LIMIT=300
POSTGRESQL_CPU_RESERVATION=0.25
POSTGRESQL_CPU_LIMIT=1.0
POSTGRESQL_MEM_RESERVATION=768M
POSTGRESQL_MEM_LIMIT=2G
PGPOOL_CPU_RESERVATION=0.10
PGPOOL_CPU_LIMIT=0.50
PGPOOL_MEM_RESERVATION=192M
PGPOOL_MEM_LIMIT=512M
PGPOOL_PUBLIC_CPU_RESERVATION=0.10
PGPOOL_PUBLIC_CPU_LIMIT=0.50
PGPOOL_PUBLIC_MEM_RESERVATION=128M
PGPOOL_PUBLIC_MEM_LIMIT=256M
PGPOOL_TLS_SERVER_NAME=
CLOUDREVE_DB_SSL_MODE=disable
CLOUDREVE_DB_MAX_IDLE_CONNS=5
CLOUDREVE_DB_MAX_OPEN_CONNS=15
CLOUDREVE_DB_CONN_MAX_LIFETIME=300
CLOUDREVE_DB_CONN_MAX_IDLE_TIME=120
PG_1_DATA_MOUNT_TYPE=bind
PG_1_DATA_MOUNT_SOURCE=/srv/cloudreve-user-test/postgresql/1

# Redis 单节点。
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_AOF_ENABLED=yes
REDIS_MASTER_HOST=redis-1
REDIS_MASTER_PORT_NUMBER=6379
REDIS_PROXY_PUBLIC_PORT=16379
REDIS_CPU_RESERVATION=0.10
REDIS_CPU_LIMIT=0.50
REDIS_MEM_RESERVATION=512M
REDIS_MEM_LIMIT=1G
REDIS_PROXY_CPU_RESERVATION=0.05
REDIS_PROXY_CPU_LIMIT=0.25
REDIS_PROXY_MEM_RESERVATION=128M
REDIS_PROXY_MEM_LIMIT=256M
REDIS_PROXY_PUBLIC_CPU_RESERVATION=0.05
REDIS_PROXY_PUBLIC_CPU_LIMIT=0.25
REDIS_PROXY_PUBLIC_MEM_RESERVATION=128M
REDIS_PROXY_PUBLIC_MEM_LIMIT=256M
REDIS_PROXY_TLS_SERVER_NAME=
REDIS_1_DATA_MOUNT_TYPE=bind
REDIS_1_DATA_MOUNT_SOURCE=/srv/cloudreve-user-test/redis/1

# 单节点 MinIO / Elasticsearch / Kafka。
MINIO_DATA_MOUNT_TYPE=bind
MINIO_DATA_MOUNT_SOURCE=/srv/cloudreve-user-test/minio
MINIO_CPU_RESERVATION=0.10
MINIO_CPU_LIMIT=1.0
MINIO_MEM_RESERVATION=768M
MINIO_MEM_LIMIT=2G
MINIO_PUBLIC_CPU_RESERVATION=0.05
MINIO_PUBLIC_CPU_LIMIT=0.25
MINIO_PUBLIC_MEM_RESERVATION=128M
MINIO_PUBLIC_MEM_LIMIT=256M
MINIO_INIT_CPU_RESERVATION=0.05
MINIO_INIT_CPU_LIMIT=0.25
MINIO_INIT_MEM_RESERVATION=64M
MINIO_INIT_MEM_LIMIT=128M

ELASTICSEARCH_DATA_MOUNT_TYPE=bind
ELASTICSEARCH_DATA_MOUNT_SOURCE=/srv/cloudreve-user-test/elasticsearch
ELASTICSEARCH_HTTP_PORT=19200
ELASTICSEARCH_TRANSPORT_PORT=19300
ELASTICSEARCH_JAVA_OPTS="-Xms1g -Xmx1g"
ELASTICSEARCH_CPU_RESERVATION=0.25
ELASTICSEARCH_CPU_LIMIT=2.0
ELASTICSEARCH_MEM_RESERVATION=1G
ELASTICSEARCH_MEM_LIMIT=2G
ELASTICSEARCH_PUBLIC_CPU_RESERVATION=0.05
ELASTICSEARCH_PUBLIC_CPU_LIMIT=0.25
ELASTICSEARCH_PUBLIC_MEM_RESERVATION=128M
ELASTICSEARCH_PUBLIC_MEM_LIMIT=256M
ELASTICSEARCH_PUBLIC_TLS_EXTRA_SANS=127.0.0.1

KAFKA_DATA_MOUNT_TYPE=bind
KAFKA_DATA_MOUNT_SOURCE=/srv/cloudreve-user-test/kafka
KAFKA_SINGLE_NODE_ADVERTISED_LISTENER=kafka:9092
KAFKA_SINGLE_NODE_CONTROLLER_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_SINGLE_NODE_CONTROLLER_QUORUM_VOTERS=1@localhost:9093
KAFKA_SINGLE_NODE_JVM_HEAP_OPTS="-Xms512m -Xmx512m"
KAFKA_SINGLE_NODE_NUM_PARTITIONS=1
KAFKA_SINGLE_NODE_DEFAULT_REPLICATION_FACTOR=1
KAFKA_SINGLE_NODE_MIN_INSYNC_REPLICAS=1
KAFKA_SINGLE_NODE_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_SINGLE_NODE_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_SINGLE_NODE_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_SINGLE_NODE_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_CPU_RESERVATION=0.15
KAFKA_CPU_LIMIT=1.0
KAFKA_MEM_RESERVATION=768M
KAFKA_MEM_LIMIT=2G
KAFKA_PROXY_CPU_RESERVATION=0.05
KAFKA_PROXY_CPU_LIMIT=0.25
KAFKA_PROXY_MEM_RESERVATION=128M
KAFKA_PROXY_MEM_LIMIT=256M
KAFKA_UI_HTTP_PORT=18089
KAFKA_UI_CLUSTER_NAME=cloudreve-user-test-kafka
KAFKA_UI_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_UI_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_UI_DYNAMIC_CONFIG_ENABLED=false
KAFKA_UI_TRUSTSTORE_LOCATION="${SWARM_PKI_MOUNT_TARGET}/ca/truststore.p12"
KAFKA_UI_TRUSTSTORE_PASSWORD="${SWARM_TRUSTSTORE_PASSWORD}"
KAFKA_UI_TRUSTSTORE_TYPE=PKCS12
KAFKA_UI_JAVA_TOOL_OPTIONS="-Djavax.net.ssl.trustStore=${KAFKA_UI_TRUSTSTORE_LOCATION} -Djavax.net.ssl.trustStoreType=${KAFKA_UI_TRUSTSTORE_TYPE} -Djavax.net.ssl.trustStorePassword=${KAFKA_UI_TRUSTSTORE_PASSWORD}"
KAFKA_UI_CPU_RESERVATION=0.10
KAFKA_UI_CPU_LIMIT=1.00
KAFKA_UI_MEM_RESERVATION=384M
KAFKA_UI_MEM_LIMIT=1G
KAFKA_UI_PUBLIC_CPU_RESERVATION=0.05
KAFKA_UI_PUBLIC_CPU_LIMIT=0.25
KAFKA_UI_PUBLIC_MEM_RESERVATION=128M
KAFKA_UI_PUBLIC_MEM_LIMIT=256M
KAFKA_UI_SERVER_NAME=_
KAFKA_UI_TLS_EXTRA_SANS=127.0.0.1

# Tika 与共享字体。
SHARED_CUSTOM_FONTS_MOUNT_TYPE=bind
SHARED_CUSTOM_FONTS_MOUNT_SOURCE=/srv/cloudreve-user-test/shared-fonts
TIKA_CUSTOM_FONTS_MOUNT_TYPE="${SHARED_CUSTOM_FONTS_MOUNT_TYPE}"
TIKA_CUSTOM_FONTS_MOUNT_SOURCE="${SHARED_CUSTOM_FONTS_MOUNT_SOURCE}"
ONLYOFFICE_CUSTOM_FONTS_MOUNT_TYPE="${SHARED_CUSTOM_FONTS_MOUNT_TYPE}"
ONLYOFFICE_CUSTOM_FONTS_MOUNT_SOURCE="${SHARED_CUSTOM_FONTS_MOUNT_SOURCE}"
TIKA_HTTP_PORT=19998
TIKA_FONT_DIRS=/tika-fonts/custom
TIKA_FONT_DEBUG=0
TIKA_CPU_RESERVATION=0.10
TIKA_CPU_LIMIT=1.0
TIKA_MEM_RESERVATION=768M
TIKA_MEM_LIMIT=1536M
TIKA_PROXY_CPU_RESERVATION=0.10
TIKA_PROXY_CPU_LIMIT=0.50
TIKA_PROXY_MEM_RESERVATION=128M
TIKA_PROXY_MEM_LIMIT=256M
TIKA_SERVER_NAME=_
TIKA_TLS_EXTRA_SANS=127.0.0.1
TIKA_CLIENT_MAX_BODY_SIZE=0
TIKA_PROXY_READ_TIMEOUT=3600s
TIKA_PROXY_SEND_TIMEOUT=3600s

# OnlyOffice 8。
ONLYOFFICE_REPLICAS=1
ONLYOFFICE_HTTP_PORT=18090
ONLYOFFICE_SERVER_NAME=_
ONLYOFFICE_TLS_EXTRA_SANS=127.0.0.1
ONLYOFFICE_JWT_ENABLED=true
ONLYOFFICE_JWT_SECRET=replace-with-strong-onlyoffice-jwt-secret
ONLYOFFICE_DB_HOST=pgpool-internal
ONLYOFFICE_DB_PORT=5432
ONLYOFFICE_DB_NAME="${POSTGRESQL_DATABASE}"
ONLYOFFICE_DB_USER="${POSTGRESQL_USERNAME}"
ONLYOFFICE_DB_PASSWORD="${POSTGRESQL_PASSWORD}"
ONLYOFFICE_DB_SCHEMA=onlyoffice
ONLYOFFICE_REDIS_HOST=redis-1
ONLYOFFICE_REDIS_PORT=6379
ONLYOFFICE_REDIS_PASSWORD="${REDIS_PASSWORD}"
ONLYOFFICE_REDIS_DB=1
ONLYOFFICE_ALLOW_PRIVATE_IP_ADDRESS=true
ONLYOFFICE_RABBITMQ_USER=onlyoffice
ONLYOFFICE_RABBITMQ_PASSWORD=replace-with-strong-onlyoffice-rabbitmq-password
ONLYOFFICE_RABBITMQ_VHOST=onlyoffice
ONLYOFFICE_RABBITMQ_PORT=5672
ONLYOFFICE_RABBITMQ_REPLICAS=1
ONLYOFFICE_RABBITMQ_CPU_RESERVATION=0.05
ONLYOFFICE_RABBITMQ_CPU_LIMIT=1.00
ONLYOFFICE_RABBITMQ_MEM_RESERVATION=256M
ONLYOFFICE_RABBITMQ_MEM_LIMIT=1G
ONLYOFFICE_CPU_RESERVATION=0.25
ONLYOFFICE_CPU_LIMIT=1.50
ONLYOFFICE_MEM_RESERVATION=768M
ONLYOFFICE_MEM_LIMIT=2G
ONLYOFFICE_PUBLIC_CPU_RESERVATION=0.10
ONLYOFFICE_PUBLIC_CPU_LIMIT=0.50
ONLYOFFICE_PUBLIC_MEM_RESERVATION=128M
ONLYOFFICE_PUBLIC_MEM_LIMIT=256M
ONLYOFFICE_CLIENT_MAX_BODY_SIZE=0
ONLYOFFICE_PROXY_READ_TIMEOUT=3600s
ONLYOFFICE_PROXY_SEND_TIMEOUT=3600s
ONLYOFFICE_DATA_MOUNT_TYPE=volume
ONLYOFFICE_DATA_MOUNT_SOURCE=onlyoffice_data
ONLYOFFICE_LIB_MOUNT_TYPE=volume
ONLYOFFICE_LIB_MOUNT_SOURCE=onlyoffice_lib
ONLYOFFICE_LOG_MOUNT_TYPE=volume
ONLYOFFICE_LOG_MOUNT_SOURCE=onlyoffice_log
ONLYOFFICE_RABBITMQ_MOUNT_TYPE=volume
ONLYOFFICE_RABBITMQ_MOUNT_SOURCE=onlyoffice_rabbitmq

# Authverse 单节点。
AUTHVERSE_SHARED_NETWORK="${CLOUDREVE_STACK_NAME}_cloudreve_backend"
AUTHVERSE_CLOUDREVE_SERVICE_PREFIX="${CLOUDREVE_STACK_NAME}_"
AUTHVERSE_PUBLIC_BASE_URL=https://127.0.0.1:18080
AUTHVERSE_HTTP_PORT=18080
AUTHVERSE_SERVER_NAME=_
AUTHVERSE_TLS_EXTRA_SANS=127.0.0.1
AUTHVERSE_CLOUDREVE_PUBLIC_BASE_URL="${CLOUDREVE_SITE_URL}"
AUTHVERSE_CLOUDREVE_HOST_HEADER=127.0.0.1:18081
AUTHVERSE_SINGLE_CLOUDREVE_INTERNAL_UPSTREAM=cloudreve-master:5212
AUTHVERSE_SINGLE_POSTGRES_HOST=pgpool-internal
AUTHVERSE_SINGLE_POSTGRES_PORT=5432
AUTHVERSE_DB_NAME=authverse
AUTHVERSE_DB_USERNAME="${POSTGRESQL_USERNAME}"
AUTHVERSE_DB_PASSWORD="${POSTGRESQL_PASSWORD}"
AUTHVERSE_DB_MASTER_URL="jdbc:postgresql://${AUTHVERSE_SINGLE_POSTGRES_HOST}:${AUTHVERSE_SINGLE_POSTGRES_PORT}/${AUTHVERSE_DB_NAME}?sslmode=disable&tcpKeepAlive=true"
AUTHVERSE_DB_SLAVE_URL="${AUTHVERSE_DB_MASTER_URL}"
AUTHVERSE_DB_SLAVE_USERNAME="${AUTHVERSE_DB_USERNAME}"
AUTHVERSE_DB_SLAVE_PASSWORD="${AUTHVERSE_DB_PASSWORD}"
AUTHVERSE_DB_ADMIN_USER=postgres
AUTHVERSE_DB_ADMIN_PASSWORD="${POSTGRESQL_POSTGRES_PASSWORD}"
AUTHVERSE_SINGLE_DB_MASTER_URL="${AUTHVERSE_DB_MASTER_URL}"
AUTHVERSE_SINGLE_DB_SLAVE_URL="${AUTHVERSE_DB_SLAVE_URL}"
AUTHVERSE_DB_POOL_INITIAL_SIZE=1
AUTHVERSE_DB_POOL_MIN_IDLE=1
AUTHVERSE_DB_POOL_MAX_ACTIVE=4
AUTHVERSE_DB_POOL_MAX_WAIT=30000
AUTHVERSE_DB_POOL_TIME_BETWEEN_EVICTION_RUNS_MILLIS=60000
AUTHVERSE_DB_POOL_MIN_EVICTABLE_IDLE_TIME_MILLIS=600000
AUTHVERSE_DB_POOL_MAX_EVICTABLE_IDLE_TIME_MILLIS=1800000
AUTHVERSE_SINGLE_REDIS_HOST=redis-1
AUTHVERSE_SINGLE_REDIS_PORT=6379
AUTHVERSE_REDIS_PASSWORD="${REDIS_PASSWORD}"
AUTHVERSE_REDIS_DATABASE=0
AUTHVERSE_REDIS_SSL_ENABLED=false
AUTHVERSE_SINGLE_ELASTICSEARCH_URI=https://elasticsearch:9200
AUTHVERSE_ELASTICSEARCH_ENABLED=true
AUTHVERSE_ELASTICSEARCH_CONNECTION_TIMEOUT=3s
AUTHVERSE_ELASTICSEARCH_SOCKET_TIMEOUT=10s
AUTHVERSE_ELASTICSEARCH_CONNECTION_REQUEST_TIMEOUT=3s
AUTHVERSE_TENANT_ENABLED=false
AUTHVERSE_DEFAULT_TENANT_NAME=统一认证
AUTHVERSE_SITE_TITLE=统一授权中心
AUTHVERSE_LOGIN_CAPTCHA_ENABLED=false
AUTHVERSE_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTHVERSE_WEB_BUILD_NODE_OPTIONS=--max-old-space-size=4096
AUTHVERSE_OIDC_ENABLED=true
AUTHVERSE_OIDC_RSA_AUTO_GENERATE=false
AUTHVERSE_OIDC_KEY_ID=oidc-rsa-key-user-test
AUTHVERSE_OIDC_PRIVATE_KEY_PATH=classpath:oidc/private.pem
AUTHVERSE_OIDC_PUBLIC_KEY_PATH=classpath:oidc/public.pem
AUTHVERSE_OIDC_KEYS_MOUNT_TYPE=volume
AUTHVERSE_OIDC_KEYS_MOUNT_SOURCE=authverse_oidc_keys
AUTHVERSE_TOKEN_CALLBACK_ENABLED=true
AUTHVERSE_TOKEN_CALLBACK_TIMEOUT_MS=5000
AUTHVERSE_TOKEN_CALLBACK_RETRY_TIMES=3
AUTHVERSE_TOKEN_CALLBACK_RETRY_INTERVAL_MS=1000
AUTHVERSE_WEBSOCKET_SENDER_TYPE=redis
AUTHVERSE_MAX_FILE_SIZE=64MB
AUTHVERSE_MAX_REQUEST_SIZE=128MB
AUTHVERSE_JAVA_OPTS="-Xms512m -Xmx1024m -Djava.security.egd=file:/dev/./urandom"
AUTHVERSE_JAVA_TOOL_OPTIONS="-Djavax.net.ssl.trustStore=${SWARM_PKI_MOUNT_TARGET}/ca/truststore.p12 -Djavax.net.ssl.trustStoreType=PKCS12 -Djavax.net.ssl.trustStorePassword=${SWARM_TRUSTSTORE_PASSWORD}"
AUTHVERSE_SINGLE_WEB_REPLICAS=1
AUTHVERSE_WEB_CPU_RESERVATION=0.05
AUTHVERSE_WEB_CPU_LIMIT=0.50
AUTHVERSE_WEB_MEM_RESERVATION=128M
AUTHVERSE_WEB_MEM_LIMIT=512M
AUTHVERSE_SINGLE_BACKEND_REPLICAS=1
AUTHVERSE_BACKEND_CPU_RESERVATION=0.25
AUTHVERSE_BACKEND_CPU_LIMIT=2.00
AUTHVERSE_BACKEND_MEM_RESERVATION=512M
AUTHVERSE_BACKEND_MEM_LIMIT=1536M
AUTHVERSE_SINGLE_AUTO_INIT_DB=no
