CLOUDREVE_IMAGE=cloudreve/cloudreve:4.15.0
CLOUDREVE_SLAVE_IMAGE=cloudreve/cloudreve:4.15.0
NGINX_IMAGE=nginx:1.27-alpine
TIKA_IMAGE=cloudreve/tika:3.2.3.0-full-unrar-charset
PRIVATE_REGISTRY_STACK_NAME=cloudreve-debug-registry
PRIVATE_REGISTRY_IMAGE=registry:2.8.3
PRIVATE_REGISTRY_SCHEME=http
PRIVATE_REGISTRY_ADDR=192.168.106.2:15000
PRIVATE_REGISTRY_REPLICAS=0
PRIVATE_REGISTRY_HTTP_PORT=15000
PRIVATE_REGISTRY_DELETE_ENABLED=true
PRIVATE_REGISTRY_DATA_MOUNT_TYPE=bind
PRIVATE_REGISTRY_DATA_MOUNT_SOURCE=/var/lib/cloudreve-swarm-debug/registry
PRIVATE_REGISTRY_NODE_CONSTRAINT=node.hostname==colima
PRIVATE_REGISTRY_CPU_RESERVATION=0.10
PRIVATE_REGISTRY_CPU_LIMIT=0.50
PRIVATE_REGISTRY_MEM_RESERVATION=128M
PRIVATE_REGISTRY_MEM_LIMIT=256M
PRIVATE_REGISTRY_IMAGE_KEYS=TIKA,AUTHVERSE_WEB,AUTHVERSE_BACKEND
TIKA_LOCAL_IMAGE=cloudreve/tika:3.2.3.0-full-unrar-charset
TIKA_REMOTE_IMAGE=${PRIVATE_REGISTRY_ADDR}/cloudreve/tika:3.2.3.0-full-unrar-charset
AUTHVERSE_WEB_LOCAL_IMAGE=authverse/authverse-web:local-test
AUTHVERSE_WEB_REMOTE_IMAGE=${PRIVATE_REGISTRY_ADDR}/cloudreve/authverse-web:local-test
AUTHVERSE_WEB_IMAGE=${AUTHVERSE_WEB_LOCAL_IMAGE}
AUTHVERSE_BACKEND_LOCAL_IMAGE=authverse/authverse-backend:local-test
AUTHVERSE_BACKEND_REMOTE_IMAGE=${PRIVATE_REGISTRY_ADDR}/cloudreve/authverse-backend:local-test
AUTHVERSE_BACKEND_IMAGE=${AUTHVERSE_BACKEND_LOCAL_IMAGE}
POSTGRESQL_REPMGR_IMAGE=bitnamilegacy/postgresql-repmgr:17.6.0-debian-12-r2
PGPOOL_IMAGE=bitnamilegacy/pgpool:4.6.3-debian-12-r0
REDIS_IMAGE=bitnamilegacy/redis:8.2.1-debian-12-r0
REDIS_SENTINEL_IMAGE=bitnamilegacy/redis-sentinel:8.2.1-debian-12-r0
REDIS_PROXY_IMAGE=haproxy:3.0-alpine
MINIO_IMAGE=bitnamilegacy/minio:2024.10.2-debian-12-r0
KAFKA_IMAGE=apache/kafka:4.2.0
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2

CLOUDREVE_BACKEND_SUBNET=10.20.0.0/24
SWARM_WITH_CLUSTER=no

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=debug-minio-password
MINIO_DEFAULT_BUCKETS=cloudreve
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

CR_INIT_DEFAULT_STORAGE=s3
CR_INIT_S3_ENDPOINT=http://minio:9000
CR_INIT_S3_BUCKET=cloudreve
CR_INIT_S3_ACCESS_KEY=minio
CR_INIT_S3_SECRET_KEY=debug-minio-password
CR_INIT_S3_REGION=us-east-1
CR_INIT_S3_FORCE_PATH_STYLE=true
CR_INIT_S3_RELAY=true
CR_INIT_S3_INTERNAL_PROXY=true
CR_INIT_S3_IS_PRIVATE=true
CR_INIT_S3_CHUNK_SIZE=26214400

CLOUDREVE_GLOBAL_KAFKA_ENABLED=false
CLOUDREVE_GLOBAL_KAFKA_BROKERS=kafka:9092
CLOUDREVE_GLOBAL_KAFKA_VERSION=3.7.0
CLOUDREVE_GLOBAL_KAFKA_CLIENT_ID=cloudreve-debug
CLOUDREVE_GLOBAL_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_UI_HTTP_PORT=18089
KAFKA_UI_CLUSTER_NAME=cloudreve-debug-kafka
KAFKA_UI_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_UI_SECURITY_PROTOCOL=PLAINTEXT

ELASTICSEARCH_HTTP_PORT=19200
ELASTICSEARCH_TRANSPORT_PORT=19300
ELASTICSEARCH_JAVA_OPTS="-Xms2g -Xmx2g"
TIKA_HTTP_PORT=19998
TIKA_FONT_DIRS=/tika-fonts/custom
TIKA_FONT_DEBUG=0
TIKA_REPLICAS=1
TIKA_CPU_RESERVATION=0.25
TIKA_CPU_LIMIT=1.0
TIKA_MEM_RESERVATION=1G
TIKA_MEM_LIMIT=1536M

CLOUDREVE_SITE_URL=http://192.168.106.2:18080
CLOUDREVE_SESSION_SECRET=debug-session-secret-debug-session-secret-debug-session-secret-1234
CLOUDREVE_MASTER_RUNTIME_MOUNT_TYPE=volume
CLOUDREVE_MASTER_RUNTIME_MOUNT_SOURCE=cloudreve_master_runtime
