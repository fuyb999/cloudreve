TIKA_CUSTOM_FONTS_MOUNT_SOURCE=/var/lib/cloudreve-swarm-debug/tika-fonts
TIKA_CUSTOM_FONTS_HOST_PATH=/var/lib/cloudreve-swarm-debug/tika-fonts

PG_NODE_1_CONSTRAINT=node.labels.cloudreve.pg1==true
PG_NODE_2_CONSTRAINT=node.labels.cloudreve.pg2==true
