CLOUDREVE_IMAGE=cloudreve/cloudreve:4.15.0
CLOUDREVE_SLAVE_IMAGE=cloudreve/cloudreve:4.15.0
NGINX_IMAGE=nginx:1.27-alpine
TIKA_IMAGE=cloudreve/tika:3.2.3.0-full-unrar-charset
POSTGRESQL_REPMGR_IMAGE=bitnami/postgresql-repmgr:17.6.0-debian-12-r2
PGPOOL_IMAGE=bitnami/pgpool:4.6.3-debian-12-r0
REDIS_IMAGE=bitnami/redis:8.6.2
REDIS_SENTINEL_IMAGE=bitnami/redis-sentinel:8.6.2
REDIS_PROXY_IMAGE=haproxy:3.0-alpine
KAFKA_IMAGE=apache/kafka:4.2.0
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2

CLOUDREVE_BACKEND_SUBNET=10.20.0.0/24
SWARM_WITH_CLUSTER=no

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=debug-minio-password
MINIO_DEFAULT_BUCKETS=cloudreve
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

CR_INIT_DEFAULT_STORAGE=s3
CR_INIT_S3_ENDPOINT=http://minio:9000
CR_INIT_S3_BUCKET=cloudreve
CR_INIT_S3_ACCESS_KEY=minio
CR_INIT_S3_SECRET_KEY=debug-minio-password
CR_INIT_S3_REGION=us-east-1
CR_INIT_S3_FORCE_PATH_STYLE=true
CR_INIT_S3_RELAY=true
CR_INIT_S3_INTERNAL_PROXY=true
CR_INIT_S3_IS_PRIVATE=true
CR_INIT_S3_CHUNK_SIZE=26214400

CLOUDREVE_GLOBAL_KAFKA_ENABLED=false
CLOUDREVE_GLOBAL_KAFKA_BROKERS=kafka:9092
CLOUDREVE_GLOBAL_KAFKA_VERSION=3.7.0
CLOUDREVE_GLOBAL_KAFKA_CLIENT_ID=cloudreve-debug
CLOUDREVE_GLOBAL_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_UI_HTTP_PORT=18089
KAFKA_UI_CLUSTER_NAME=cloudreve-debug-kafka
KAFKA_UI_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_UI_SECURITY_PROTOCOL=PLAINTEXT

ELASTICSEARCH_HTTP_PORT=19200
ELASTICSEARCH_TRANSPORT_PORT=19300
ELASTICSEARCH_JAVA_OPTS="-Xms2g -Xmx2g"
TIKA_HTTP_PORT=19998
TIKA_FONT_DIRS=/tika-fonts/custom
TIKA_FONT_DEBUG=0
TIKA_REPLICAS=1
TIKA_CPU_RESERVATION=0.25
TIKA_CPU_LIMIT=1.0
TIKA_MEM_RESERVATION=1G
TIKA_MEM_LIMIT=1536M

CLOUDREVE_SITE_URL=http://192.168.106.2:18080
CLOUDREVE_SESSION_SECRET=debug-session-secret-debug-session-secret-debug-session-secret-1234
CLOUDREVE_MASTER_RUNTIME_MOUNT_TYPE=volume
CLOUDREVE_MASTER_RUNTIME_MOUNT_SOURCE=cloudreve_master_runtime
CLOUDREVE_MASTER_REPLICAS=1
CLOUDREVE_MASTER_CPU_RESERVATION=0.5
CLOUDREVE_MASTER_CPU_LIMIT=1.0
CLOUDREVE_MASTER_MEM_RESERVATION=1G
CLOUDREVE_MASTER_MEM_LIMIT=2G

CLOUDREVE_MASTER_HTTP_PORT=18080
CLOUDREVE_MASTER_PROXY_REPLICAS=1
CLOUDREVE_MASTER_SERVER_NAME=_
CLOUDREVE_MASTER_CLIENT_MAX_BODY_SIZE=0
CLOUDREVE_MASTER_PROXY_READ_TIMEOUT=3600s
CLOUDREVE_MASTER_PROXY_SEND_TIMEOUT=3600s
CLOUDREVE_MASTER_PROXY_CPU_RESERVATION=0.1
CLOUDREVE_MASTER_PROXY_CPU_LIMIT=0.5
CLOUDREVE_MASTER_PROXY_MEM_RESERVATION=256M
CLOUDREVE_MASTER_PROXY_MEM_LIMIT=512M

SWARM_ROLLING_ORDER=stop-first

CLOUDREVE_SLAVE_SECRET=debug-slave-secret-debug-slave-secret-debug-slave-secret-debug-1234
CLOUDREVE_SLAVE_RUNTIME_MOUNT_TYPE=volume
CLOUDREVE_SLAVE_RUNTIME_MOUNT_SOURCE=cloudreve_slave_runtime
CLOUDREVE_SLAVE_REPLICAS=1
CLOUDREVE_SLAVE_CPU_RESERVATION=0.25
CLOUDREVE_SLAVE_CPU_LIMIT=1.0
CLOUDREVE_SLAVE_MEM_RESERVATION=1G
CLOUDREVE_SLAVE_MEM_LIMIT=1536M

CLOUDREVE_SLAVE_HTTP_PORT=15213
CLOUDREVE_SLAVE_PROXY_REPLICAS=1
CLOUDREVE_SLAVE_SERVER_NAME=_
CLOUDREVE_SLAVE_CLIENT_MAX_BODY_SIZE=0
CLOUDREVE_SLAVE_PROXY_READ_TIMEOUT=3600s
CLOUDREVE_SLAVE_PROXY_SEND_TIMEOUT=3600s
CLOUDREVE_SLAVE_PROXY_CPU_RESERVATION=0.1
CLOUDREVE_SLAVE_PROXY_CPU_LIMIT=0.5
CLOUDREVE_SLAVE_PROXY_MEM_RESERVATION=256M
CLOUDREVE_SLAVE_PROXY_MEM_LIMIT=512M

POSTGRESQL_USERNAME=cloudreve
POSTGRESQL_DATABASE=cloudreve
POSTGRESQL_PASSWORD=debug-postgres-password
POSTGRESQL_POSTGRES_PASSWORD=debug-postgres-root-password
POSTGRESQL_NUM_SYNCHRONOUS_REPLICAS=0
REPMGR_PASSWORD=debug-repmgr-password
PGPOOL_REPLICAS=1
PGPOOL_ADMIN_USERNAME=admin
PGPOOL_ADMIN_PASSWORD=debug-pgpool-admin-password
PGPOOL_PUBLIC_PORT=15432
POSTGRESQL_CPU_RESERVATION=0.5
POSTGRESQL_CPU_LIMIT=1.0
POSTGRESQL_MEM_RESERVATION=1G
POSTGRESQL_MEM_LIMIT=2G
PGPOOL_CPU_RESERVATION=0.25
PGPOOL_CPU_LIMIT=0.5
PGPOOL_MEM_RESERVATION=256M
PGPOOL_MEM_LIMIT=512M

REDIS_PASSWORD=debug-redis-password
REDIS_AOF_ENABLED=yes
REDIS_MASTER_HOST=redis-1
REDIS_MASTER_PORT_NUMBER=6379
REDIS_SENTINEL_MASTER_SET=mymaster
REDIS_SENTINEL_REPLICAS=1
REDIS_SENTINEL_QUORUM=1
REDIS_SENTINEL_DOWN_AFTER_MILLISECONDS=5000
REDIS_SENTINEL_FAILOVER_TIMEOUT=10000
REDIS_PROXY_REPLICAS=1
REDIS_PROXY_PUBLIC_PORT=16379
REDIS_CPU_RESERVATION=0.1
REDIS_CPU_LIMIT=0.5
REDIS_MEM_RESERVATION=512M
REDIS_MEM_LIMIT=1G
REDIS_SENTINEL_CPU_RESERVATION=0.05
REDIS_SENTINEL_CPU_LIMIT=0.25
REDIS_SENTINEL_MEM_RESERVATION=128M
REDIS_SENTINEL_MEM_LIMIT=256M
REDIS_PROXY_CPU_RESERVATION=0.05
REDIS_PROXY_CPU_LIMIT=0.25
REDIS_PROXY_MEM_RESERVATION=128M
REDIS_PROXY_MEM_LIMIT=256M

MINIO_DATA_MOUNT_TYPE=volume
MINIO_DATA_MOUNT_SOURCE=minio_data
MINIO_CPU_RESERVATION=0.25
MINIO_CPU_LIMIT=1.0
MINIO_MEM_RESERVATION=1G
MINIO_MEM_LIMIT=2G
ELASTICSEARCH_DATA_MOUNT_TYPE=volume
ELASTICSEARCH_DATA_MOUNT_SOURCE=elasticsearch_data
ELASTICSEARCH_CPU_RESERVATION=0.5
ELASTICSEARCH_CPU_LIMIT=2.0
ELASTICSEARCH_MEM_RESERVATION=2G
ELASTICSEARCH_MEM_LIMIT=3G

PG_1_DATA_PATH=/var/lib/cloudreve-debug/postgresql/1
PG_2_DATA_PATH=/var/lib/cloudreve-debug/postgresql/2
PG_3_DATA_PATH=/var/lib/cloudreve-debug/postgresql/3
REDIS_1_DATA_PATH=/var/lib/cloudreve-debug/redis/1
REDIS_2_DATA_PATH=/var/lib/cloudreve-debug/redis/2
REDIS_3_DATA_PATH=/var/lib/cloudreve-debug/redis/3
TIKA_CUSTOM_FONTS_MOUNT_TYPE=bind
TIKA_CUSTOM_FONTS_MOUNT_SOURCE=/var/lib/cloudreve-debug/tika-fonts
TIKA_CUSTOM_FONTS_HOST_PATH=/var/lib/cloudreve-debug/tika-fonts

PG_NODE_1_CONSTRAINT=node.labels.cloudreve.pg1==true
PG_NODE_2_CONSTRAINT=node.labels.cloudreve.pg2==true
PG_NODE_3_CONSTRAINT=node.labels.cloudreve.pg3==true
REDIS_NODE_1_CONSTRAINT=node.labels.cloudreve.redis1==true
REDIS_NODE_2_CONSTRAINT=node.labels.cloudreve.redis2==true
REDIS_NODE_3_CONSTRAINT=node.labels.cloudreve.redis3==true
