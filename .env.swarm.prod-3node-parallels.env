# Parallels 3 节点真实联调环境：
# - 基于 `.env.swarm.prod-4x256g.example` 继承
# - manager: u22-swarm-mgr-11 / 10.37.129.11
# - worker : u22-swarm-wkr-12 / 10.37.129.12
# - worker : u22-swarm-wkr-13 / 10.37.129.13
# - 用途：在本机完成 registry -> 私有镜像发布 -> foundation/infra/cloudreve/auth 全链路真实联调
#
# 注意：
# - 本文件只覆盖三节点测试所需的差异项
# - 生产基线仍以 `.env.swarm.prod-4x256g.example` 为准
# - 所有测试数据目录统一落到 `/srv/cloudreve-prl3prod` 与 `/srv/cloudreve-prl3prod-assets`

ENV_BASE_FILE=".env.swarm.prod-4x256g.example"

SWARM_IMAGE_SOURCE="remote"
SWARM_ROLLING_ORDER="stop-first"

SWARM_SHARED_NETWORK="cloudreve-prl3prod_backend"
FOUNDATION_STACK_NAME="cloudreve-prl3prod-foundation"
INFRA_STACK_NAME="cloudreve-prl3prod-infra"
CLOUDREVE_STACK_NAME="cloudreve-prl3prod-app"
AUTHVERSE_STACK_NAME="authverse-prl3prod"
PRIVATE_REGISTRY_STACK_NAME="cloudreve-registry-prl3prod"
CLOUDREVE_FOUNDATION_SERVICE_PREFIX="${FOUNDATION_STACK_NAME}_"
CLOUDREVE_INFRA_SERVICE_PREFIX="${INFRA_STACK_NAME}_"
CLOUDREVE_APP_SERVICE_PREFIX="${CLOUDREVE_STACK_NAME}_"
AUTHVERSE_SHARED_NETWORK="${SWARM_SHARED_NETWORK}"
AUTHVERSE_CLOUDREVE_SERVICE_PREFIX="${CLOUDREVE_APP_SERVICE_PREFIX}"
CLOUDREVE_BACKEND_SUBNET="10.43.0.0/24"

PRIVATE_REGISTRY_ADDR="10.37.129.11:15000"
PRIVATE_REGISTRY_SERVER_NAME="10.37.129.11"
