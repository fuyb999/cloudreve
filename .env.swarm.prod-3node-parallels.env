AUTHVERSE_REDIS_HOST="${CLOUDREVE_FOUNDATION_SERVICE_PREFIX}redis-proxy-internal"
AUTHVERSE_REDIS_PORT="6379"
AUTHVERSE_ELASTICSEARCH_URI="http://${CLOUDREVE_INFRA_SERVICE_PREFIX}elasticsearch-internal:9200"
AUTHVERSE_DB_NAME="authverse"
AUTHVERSE_DB_USERNAME="${POSTGRESQL_USERNAME}"
AUTHVERSE_DB_PASSWORD="${POSTGRESQL_PASSWORD}"
AUTHVERSE_DB_MASTER_URL="jdbc:postgresql://${AUTHVERSE_POSTGRES_HOST}:${AUTHVERSE_POSTGRES_PORT}/${AUTHVERSE_DB_NAME}?sslmode=disable&tcpKeepAlive=true"
AUTHVERSE_DB_SLAVE_URL="${AUTHVERSE_DB_MASTER_URL}"
AUTHVERSE_DB_SLAVE_USERNAME="${AUTHVERSE_DB_USERNAME}"
AUTHVERSE_DB_SLAVE_PASSWORD="${AUTHVERSE_DB_PASSWORD}"
AUTHVERSE_DB_ADMIN_USER="postgres"
AUTHVERSE_DB_ADMIN_PASSWORD="${POSTGRESQL_POSTGRES_PASSWORD}"
AUTHVERSE_DB_INIT_MODE="primary-exec"
AUTHVERSE_DB_POOL_INITIAL_SIZE="1"
AUTHVERSE_DB_POOL_MIN_IDLE="1"
AUTHVERSE_DB_POOL_MAX_ACTIVE="4"
AUTHVERSE_DB_POOL_MAX_WAIT="30000"
AUTHVERSE_DB_POOL_TIME_BETWEEN_EVICTION_RUNS_MILLIS="60000"
AUTHVERSE_DB_POOL_MIN_EVICTABLE_IDLE_TIME_MILLIS="600000"
AUTHVERSE_DB_POOL_MAX_EVICTABLE_IDLE_TIME_MILLIS="1800000"
AUTHVERSE_REDIS_PASSWORD="${REDIS_PASSWORD}"
AUTHVERSE_REDIS_DATABASE="0"
AUTHVERSE_REDIS_SSL_ENABLED="false"
AUTHVERSE_OIDC_ENABLED="true"
AUTHVERSE_OIDC_RSA_AUTO_GENERATE="true"
AUTHVERSE_OIDC_KEY_ID="oidc-rsa-key-prl3prod"
AUTHVERSE_OIDC_KEYS_MOUNT_TYPE="volume"
AUTHVERSE_OIDC_KEYS_MOUNT_SOURCE="authverse_oidc_keys"
AUTHVERSE_JAVA_OPTS="-Xms384m -Xmx768m -Djava.security.egd=file:/dev/./urandom"
AUTHVERSE_WEB_REPLICAS="1"
AUTHVERSE_WEB_CPU_RESERVATION="0.05"
AUTHVERSE_WEB_CPU_LIMIT="0.25"
AUTHVERSE_WEB_MEM_RESERVATION="64M"
AUTHVERSE_WEB_MEM_LIMIT="192M"
AUTHVERSE_BACKEND_REPLICAS="1"
AUTHVERSE_BACKEND_CPU_RESERVATION="0.15"
AUTHVERSE_BACKEND_CPU_LIMIT="0.75"
AUTHVERSE_BACKEND_MEM_RESERVATION="256M"
AUTHVERSE_BACKEND_MEM_LIMIT="768M"
AUTHVERSE_BACKEND_HEALTHCHECK_START_PERIOD="180s"

CLOUDREVE_MASTER_NODE_CONSTRAINT="node.labels.cloudreve.master==true"
CLOUDREVE_MASTER_PROXY_NODE_CONSTRAINT="node.labels.cloudreve.edge==true"
CLOUDREVE_SLAVE_NODE_CONSTRAINT="node.labels.cloudreve.slave==true"
