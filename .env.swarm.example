# Tika / OnlyOffice 共享外挂字体目录。
# 推荐两者共用一套字体，证书和字体都由宿主机统一管理。
# 兼容两种模式：
# - `volume`：默认兼容性最好
# - `bind`：挂宿主机绝对路径
SHARED_CUSTOM_FONTS_MOUNT_TYPE=volume
SHARED_CUSTOM_FONTS_MOUNT_SOURCE=shared_custom_fonts
TIKA_CUSTOM_FONTS_MOUNT_TYPE="${SHARED_CUSTOM_FONTS_MOUNT_TYPE}"
TIKA_CUSTOM_FONTS_MOUNT_SOURCE="${SHARED_CUSTOM_FONTS_MOUNT_SOURCE}"
ONLYOFFICE_CUSTOM_FONTS_MOUNT_TYPE="${SHARED_CUSTOM_FONTS_MOUNT_TYPE}"
ONLYOFFICE_CUSTOM_FONTS_MOUNT_SOURCE="${SHARED_CUSTOM_FONTS_MOUNT_SOURCE}"
TIKA_NODE_CONSTRAINT=node.platform.os==linux
TIKA_SERVER_NAME=tika.example.com
TIKA_TLS_EXTRA_SANS=
TIKA_PROXY_REPLICAS=2
TIKA_PROXY_NODE_CONSTRAINT=node.platform.os==linux
TIKA_PROXY_CPU_RESERVATION=0.25
TIKA_PROXY_CPU_LIMIT=1.0
TIKA_PROXY_MEM_RESERVATION=256M
TIKA_PROXY_MEM_LIMIT=512M
TIKA_CLIENT_MAX_BODY_SIZE=0
TIKA_PROXY_READ_TIMEOUT=3600s
TIKA_PROXY_SEND_TIMEOUT=3600s

# 有状态服务的 Swarm 节点约束。
# 标签示例：
# docker node update --label-add cloudreve.pg1=true <node-name>
# docker node update --label-add cloudreve.pg2=true <node-name>
# docker node update --label-add cloudreve.pg3=true <node-name>
# docker node update --label-add cloudreve.redis1=true <node-name>
# docker node update --label-add cloudreve.redis2=true <node-name>
# docker node update --label-add cloudreve.redis3=true <node-name>
# 如果可选 bind 服务也要固定节点，可继续打这些标签：
# docker node update --label-add cloudreve.master=true <node-name>
# docker node update --label-add cloudreve.slave=true <node-name>
# docker node update --label-add cloudreve.edge=true <node-name>
# docker node update --label-add cloudreve.minio=true <node-name>
# docker node update --label-add cloudreve.elasticsearch=true <node-name>
# docker node update --label-add cloudreve.tika=true <node-name>
# docker node update --label-add cloudreve.redis-sentinel=true <node-name>
# 如果启用集群模式，建议再打这些标签：
# docker node update --label-add cloudreve.minio1=true <node-name>
# docker node update --label-add cloudreve.minio2=true <node-name>
# docker node update --label-add cloudreve.minio3=true <node-name>
# docker node update --label-add cloudreve.minio4=true <node-name>
# docker node update --label-add cloudreve.es1=true <node-name>
# docker node update --label-add cloudreve.es2=true <node-name>
# docker node update --label-add cloudreve.es3=true <node-name>
# docker node update --label-add cloudreve.kafka1=true <node-name>
# docker node update --label-add cloudreve.kafka2=true <node-name>
# docker node update --label-add cloudreve.kafka3=true <node-name>
# docker node update --label-add cloudreve.kafka-ui=true <node-name>
# docker node update --label-add cloudreve.registry=true <node-name>
PG_NODE_1_CONSTRAINT=node.labels.cloudreve.pg1==true
PG_NODE_2_CONSTRAINT=node.labels.cloudreve.pg2==true
PG_NODE_3_CONSTRAINT=node.labels.cloudreve.pg3==true
REDIS_NODE_1_CONSTRAINT=node.labels.cloudreve.redis1==true
REDIS_NODE_2_CONSTRAINT=node.labels.cloudreve.redis2==true
REDIS_NODE_3_CONSTRAINT=node.labels.cloudreve.redis3==true
MINIO_NODE_1_CONSTRAINT=node.labels.cloudreve.minio1==true
MINIO_NODE_2_CONSTRAINT=node.labels.cloudreve.minio2==true
MINIO_NODE_3_CONSTRAINT=node.labels.cloudreve.minio3==true
MINIO_NODE_4_CONSTRAINT=node.labels.cloudreve.minio4==true
ELASTICSEARCH_NODE_1_CONSTRAINT=node.labels.cloudreve.es1==true
ELASTICSEARCH_NODE_2_CONSTRAINT=node.labels.cloudreve.es2==true
ELASTICSEARCH_NODE_3_CONSTRAINT=node.labels.cloudreve.es3==true
KAFKA_PROXY_NODE_CONSTRAINT=node.platform.os==linux
KAFKA_NODE_1_CONSTRAINT=node.labels.cloudreve.kafka1==true
KAFKA_NODE_2_CONSTRAINT=node.labels.cloudreve.kafka2==true
KAFKA_NODE_3_CONSTRAINT=node.labels.cloudreve.kafka3==true
KAFKA_UI_NODE_CONSTRAINT=node.platform.os==linux
