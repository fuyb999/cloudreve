# PostgreSQL and Redis do not use shared storage.
# Each PG / Redis replica keeps its own dedicated data volume pinned to a specific node.
#
# Shared storage here only means the runtime directory required by multi-master Cloudreve.
# User file blobs are recommended to live in MinIO / S3 compatible storage, not in this path.
CLOUDREVE_SHARED_DATA_PATH=/srv/cloudreve/master-data
TIKA_CUSTOM_FONTS_HOST_PATH=/srv/cloudreve/tika-fonts

# Images. Keep master and slave on the same Cloudreve version per official docs.
CLOUDREVE_IMAGE=cloudreve/cloudreve:latest
CLOUDREVE_SLAVE_IMAGE=cloudreve/cloudreve:latest
NGINX_IMAGE=nginx:1.27-alpine
TIKA_IMAGE=registry.example.com/cloudreve/tika:3.2.3.0-full-unrar-charset
POSTGRESQL_REPMGR_IMAGE=bitnami/postgresql-repmgr:17
PGPOOL_IMAGE=bitnami/pgpool:4
REDIS_IMAGE=bitnami/redis:7.4
REDIS_SENTINEL_IMAGE=bitnami/redis-sentinel:7.4
REDIS_PROXY_IMAGE=haproxy:3.0-alpine

# MinIO. Recommended as Cloudreve file blob storage.
# These variables only configure the bundled MinIO service in this stack.
# Cloudreve will NOT switch to MinIO automatically; configure a MinIO/S3 compatible
# storage policy in the Cloudreve admin UI after first boot.
# If you already have an external MinIO cluster or managed object storage,
# you can replace the built-in `minio` service and keep Cloudreve pointed there.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Cloudreve master. Set this to the public URL configured in Cloudreve Basic Settings -> Site URL.
CLOUDREVE_SITE_URL=https://cloudreve.example.com
CLOUDREVE_SESSION_SECRET=replace-with-at-least-64-random-chars
# Keep this at 1 until CLOUDREVE_SHARED_DATA_PATH is backed by a reliable
# shared POSIX filesystem mounted on every node that may run cloudreve-master.
CLOUDREVE_MASTER_REPLICAS=1
CLOUDREVE_MASTER_MEM_RESERVATION=512M
CLOUDREVE_MASTER_MEM_LIMIT=2G

# Master reverse proxy. The published port is the public entrypoint for users.
CLOUDREVE_MASTER_HTTP_PORT=80
CLOUDREVE_MASTER_PROXY_REPLICAS=2
CLOUDREVE_MASTER_SERVER_NAME=_
CLOUDREVE_MASTER_CLIENT_MAX_BODY_SIZE=0
CLOUDREVE_MASTER_PROXY_READ_TIMEOUT=3600s
CLOUDREVE_MASTER_PROXY_SEND_TIMEOUT=3600s

# Cloudreve slave.
# First deploy can keep the placeholder below.
# After master is up, create a node in Cloudreve admin, then replace this with the generated "Slave Key".
# Register the node URL in admin as http(s)://<your-slave-proxy-host>:<CLOUDREVE_SLAVE_HTTP_PORT>
# This template assumes slave replicas are used for processing / remote node capability,
# not as a shared local file blob cluster.
CLOUDREVE_SLAVE_SECRET=replace-with-cloudreve-admin-generated-slave-key
CLOUDREVE_SLAVE_REPLICAS=2
CLOUDREVE_SLAVE_MEM_RESERVATION=256M
CLOUDREVE_SLAVE_MEM_LIMIT=1G

# Slave reverse proxy.
CLOUDREVE_SLAVE_HTTP_PORT=5213
CLOUDREVE_SLAVE_PROXY_REPLICAS=2
CLOUDREVE_SLAVE_SERVER_NAME=_
CLOUDREVE_SLAVE_CLIENT_MAX_BODY_SIZE=0
CLOUDREVE_SLAVE_PROXY_READ_TIMEOUT=3600s
CLOUDREVE_SLAVE_PROXY_SEND_TIMEOUT=3600s

# Tika
TIKA_REPLICAS=2
TIKA_HTTP_PORT=9998
TIKA_FONT_DIRS=/tika-fonts/custom
TIKA_FONT_DEBUG=0
TIKA_MEM_RESERVATION=512M
TIKA_MEM_LIMIT=2G

# PostgreSQL HA
POSTGRESQL_USERNAME=cloudreve
POSTGRESQL_DATABASE=cloudreve
POSTGRESQL_PASSWORD=replace-with-strong-app-password
POSTGRESQL_POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRESQL_NUM_SYNCHRONOUS_REPLICAS=1
REPMGR_PASSWORD=replace-with-strong-repmgr-password
PGPOOL_REPLICAS=2
PGPOOL_ADMIN_USERNAME=admin
PGPOOL_ADMIN_PASSWORD=replace-with-strong-pgpool-admin-password

# Redis HA
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_SENTINEL_MASTER_SET=mymaster
REDIS_SENTINEL_REPLICAS=3
REDIS_SENTINEL_QUORUM=2
REDIS_SENTINEL_DOWN_AFTER_MILLISECONDS=5000
REDIS_SENTINEL_FAILOVER_TIMEOUT=10000
REDIS_PROXY_REPLICAS=2

# Swarm placement constraints for stateful services.
# Example labeling:
# docker node update --label-add cloudreve.pg1=true <node-name>
# docker node update --label-add cloudreve.pg2=true <node-name>
# docker node update --label-add cloudreve.pg3=true <node-name>
# docker node update --label-add cloudreve.redis1=true <node-name>
# docker node update --label-add cloudreve.redis2=true <node-name>
# docker node update --label-add cloudreve.redis3=true <node-name>
PG_NODE_1_CONSTRAINT=node.labels.cloudreve.pg1==true
PG_NODE_2_CONSTRAINT=node.labels.cloudreve.pg2==true
PG_NODE_3_CONSTRAINT=node.labels.cloudreve.pg3==true
REDIS_NODE_1_CONSTRAINT=node.labels.cloudreve.redis1==true
REDIS_NODE_2_CONSTRAINT=node.labels.cloudreve.redis2==true
REDIS_NODE_3_CONSTRAINT=node.labels.cloudreve.redis3==true
