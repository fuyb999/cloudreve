# MinIO / Elasticsearch 集群模式参数。
# 适用拓扑：
# - 1 个 manager + 3 个 worker
# - 4 个 MinIO 数据节点
# - 3 个 Elasticsearch 数据节点
# - 3 个 Kafka 数据节点
# - 代理入口 `minio` / `elasticsearch` 可放在任意可对外提供端口的节点
MINIO_PROXY_REPLICAS=1
MINIO_PROXY_NODE_CONSTRAINT=node.platform.os==linux
MINIO_PROXY_CPU_RESERVATION=0.25
MINIO_PROXY_CPU_LIMIT=1.0
MINIO_PROXY_MEM_RESERVATION=256M
MINIO_PROXY_MEM_LIMIT=512M
MINIO_PUBLIC_REPLICAS=1
MINIO_PUBLIC_NODE_CONSTRAINT=node.platform.os==linux
MINIO_PUBLIC_CPU_RESERVATION=0.25
MINIO_PUBLIC_CPU_LIMIT=1.0
MINIO_PUBLIC_MEM_RESERVATION=256M
MINIO_PUBLIC_MEM_LIMIT=512M
MINIO_INIT_ENDPOINT=http://minio-internal:9000
MINIO_INIT_REPLICAS=1
MINIO_INIT_NODE_CONSTRAINT=node.platform.os==linux
MINIO_INIT_CPU_RESERVATION=0.05
MINIO_INIT_CPU_LIMIT=0.25
MINIO_INIT_MEM_RESERVATION=64M
MINIO_INIT_MEM_LIMIT=128M
MINIO_INIT_INTERVAL_SECONDS=30
MINIO_DISTRIBUTED_NODES=minio-1,minio-2,minio-3,minio-4
MINIO_CLUSTER_NODE_CPU_RESERVATION=1.0
MINIO_CLUSTER_NODE_CPU_LIMIT=2.0
MINIO_CLUSTER_NODE_MEM_RESERVATION=2G
MINIO_CLUSTER_NODE_MEM_LIMIT=4G
MINIO_1_DATA_MOUNT_TYPE=volume
MINIO_1_DATA_MOUNT_SOURCE=minio_1_data
MINIO_2_DATA_MOUNT_TYPE=volume
MINIO_2_DATA_MOUNT_SOURCE=minio_2_data
MINIO_3_DATA_MOUNT_TYPE=volume
MINIO_3_DATA_MOUNT_SOURCE=minio_3_data
MINIO_4_DATA_MOUNT_TYPE=volume
MINIO_4_DATA_MOUNT_SOURCE=minio_4_data

